---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { checkMeta } from "../lib/verification";

interface Props {
  title: string;
  description: string;
  /** Defaults to indexable. Gated pages pass their own value. */
  robots?: string;
  /** ISO date — should match the record's verification or sourcing date. */
  dateModified?: string | null;
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  robots = "index, follow, max-snippet:-1, max-image-preview:large",
  dateModified = null,
  schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Every page runs the SERP-length check, so a new page can't quietly ship a
// title Google will cut in half.
checkMeta(Astro.url.pathname, title, description);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1E2A33" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Deep Creek Field Guide" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <link rel="sitemap" href="/sitemap-index.xml" />

    {schema.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:px-4 focus:py-3 focus:bg-slate focus:text-snow"
    >
      Skip to content
    </a>

    <Header />
    <main id="main"><slot /></main>
    <Footer />
  
<script>
  /*
   * Reveal-on-scroll.
   *
   * The ordering here is the whole point. The hidden state lives behind a
   * .js-reveal class that this script adds, so the page is FULLY VISIBLE until
   * JavaScript has proved it is running and capable of undoing it. No script,
   * blocked script, dead observer, ancient browser — content still shows.
   *
   * There is also a hard timeout. An IntersectionObserver can fail to fire for
   * reasons that have nothing to do with this code, and the failure mode would
   * be a blank page that looks deliberate. After 1.5s everything is revealed
   * whether or not the observer ever spoke.
   */
  (() => {
    const targets = document.querySelectorAll("[data-reveal]");
    if (!targets.length) return;

    const showAll = () => targets.forEach((el) => el.classList.add("is-in"));

    if (
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
      !("IntersectionObserver" in window)
    ) {
      return;   // never gated, so nothing to undo
    }

    document.documentElement.classList.add("js-reveal");
    const safety = setTimeout(showAll, 1500);

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
    );
    targets.forEach((el) => io.observe(el));

    /* Anything already on screen at load should not wait for a scroll. */
    requestAnimationFrame(() => {
      targets.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.top < window.innerHeight && r.bottom > 0) {
          el.classList.add("is-in");
          io.unobserve(el);
        }
      });
    });

    window.addEventListener("pagehide", () => clearTimeout(safety), { once: true });
  })();
</script>
</body>
</html>
