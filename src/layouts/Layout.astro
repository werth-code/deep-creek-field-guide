---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { checkMeta } from "../lib/verification";

interface Props {
  title: string;
  description: string;
  /** Defaults to indexable. Gated pages pass their own value. */
  robots?: string;
  /** ISO date — should match the record's verification or sourcing date. */
  dateModified?: string | null;
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  robots = "index, follow, max-snippet:-1, max-image-preview:large",
  dateModified = null,
  schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Every page runs the SERP-length check, so a new page can't quietly ship a
// title Google will cut in half.
checkMeta(Astro.url.pathname, title, description);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1E2A33" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Deep Creek Field Guide" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <link rel="sitemap" href="/sitemap-index.xml" />

    {schema.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:px-4 focus:py-3 focus:bg-slate focus:text-snow"
    >
      Skip to content
    </a>

    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
