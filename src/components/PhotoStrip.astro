---
/**
 * Every photograph in a section, in one swipeable row, each one a link.
 *
 * WHY
 * The listing sorts photographed records first, which helps, but the pictures
 * still only appear once you have scrolled to the card that owns them. This
 * puts the whole section's photography above the fold, and every frame is a
 * door into the record it came from — which is the fastest route from "this
 * looks worth the drive" to the page that says what it costs.
 *
 * HOW IT SCROLLS
 * CSS scroll-snap on an overflow-x row, the same mechanism CardGallery uses.
 * Momentum, rubber-banding and the swipe itself are the browser's. A
 * JavaScript carousel would reimplement all of that worse and break when the
 * script fails.
 *
 * WITHOUT JAVASCRIPT it is still a scrollable row of links that all work. The
 * script only adds the arrows and the counter, and both are hidden until it
 * runs, so nothing dead ships.
 *
 * NO DRAG-SUPPRESSION HERE, unlike CardGallery. There each frame sat on top of
 * a stretched link covering the whole card, so a swipe had to be told not to
 * navigate. These are ordinary anchors in a row with nothing underneath them,
 * and a browser already knows a drag is not a click.
 */
import { colorFor } from "../lib/feature-colors";
import type { Photo } from "../lib/parks";

export interface StripItem {
  photo: Photo;
  /** Omitted on a record page — a frame that links to the page you are already
      on is a dead control that looks like a live one. */
  href?: string;
  /** The record it belongs to. Printed on the frame only when it links out. */
  name?: string;
}

interface Props {
  items: StripItem[];
  /** Section colour for the rule and the counter. */
  accent?: string;
  /** Show each photo's caption under it. On for a record page, off for a
      listing, where twenty captions would bury the parks. */
  captions?: boolean;
  /**
   * One photograph at a time, filling the width.
   *
   * A filmstrip that shows the edge of the next frame is right for a listing —
   * the peek is what tells you to swipe. On a record page it just makes the
   * photograph smaller for no gain, because you are already committed to this
   * park and want to look at it.
   */
  fill?: boolean;
  /** Heading over the row. */
  heading?: string;
  class?: string;
}
const {
  items,
  accent = "trails",
  captions = false,
  fill = false,
  heading = "From these pages",
  class: klass = "",
} = Astro.props;
---

{
  items.length > 0 && (
    <figure class={`m-0 ${klass}`} data-strip data-strip-fill={fill ? "1" : "0"}>
      <div class="flex items-baseline justify-between gap-4 mb-2">
        <p class="label m-0">{heading}</p>
        <p class="stamp text-ink-soft m-0" data-strip-count hidden />
      </div>

      <div
        class={`flex ${fill ? "" : "gap-3"} overflow-x-auto snap-x snap-mandatory scroll-smooth pb-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden`}
        data-strip-track
      >
        {items.map((it, i) => {
          const Frame = it.href ? "a" : "div";
          return (
          <Frame
            href={it.href}
            class={`group relative shrink-0 no-underline block ${
              fill
                ? "w-full snap-center"
                : `snap-start ${captions ? "w-[17rem] sm:w-[22rem]" : "w-[15rem] sm:w-[19rem]"}`
            }`}
            data-strip-item
          >
            <img
              src={`/photos/${it.photo.file}-700.jpg`}
              alt={it.photo.alt}
              width={700}
              height={394}
              loading={i < 2 ? "eager" : "lazy"}
              decoding="async"
              style={it.photo.focus ? `object-position:${it.photo.focus}` : undefined}
              class="w-full aspect-[16/9] object-cover block border-2 border-slate"
            />
            {/* The name sits ON the frame rather than under it, so the row
                stays one height whatever the names do. */}
            {it.name && (
              <span
                class="absolute left-0 right-0 bottom-0 px-2.5 py-1.5 stamp text-snow bg-slate/85 backdrop-blur-[2px] block truncate"
                style={`border-bottom:3px solid ${colorFor(accent)}`}
              >
                {it.name}
              </span>
            )}
            {captions && it.photo.caption && (
              <span class="block mt-2 text-[0.88rem] leading-snug text-ink">{it.photo.caption}</span>
            )}
            {captions && (it.photo.credit || it.photo.takenOn) && (
              <span class="stamp text-ink-soft block mt-1.5">
                {[it.photo.credit, it.photo.takenOn].filter(Boolean).join(" · ")}
              </span>
            )}
          </Frame>
          );
        })}
      </div>

      <figcaption class="stamp text-ink-soft mt-2">
        {items[0].href
          ? "Swipe. Every picture opens the page it was taken for."
          : "Swipe for the rest."}
      </figcaption>
    </figure>
  )
}

<script>
  (() => {
    for (const root of document.querySelectorAll("[data-strip]")) {
      if (root.dataset.bound) continue;
      root.dataset.bound = "1";

      const track = root.querySelector("[data-strip-track]");
      const count = root.querySelector("[data-strip-count]");
      const items = root.querySelectorAll("[data-strip-item]");
      if (!track || !items.length) continue;

      count.hidden = false;
      const paint = () => {
        /* Which frame is under the left edge. Good enough for "3 of 21", and
           it needs no observer. */
        const gap = root.dataset.stripFill === "1" ? 0 : 12;
        const w = items[0].getBoundingClientRect().width + gap;
        const i = Math.min(items.length - 1, Math.max(0, Math.round(track.scrollLeft / w)));
        count.textContent = `${i + 1} of ${items.length}`;
      };
      paint();
      track.addEventListener("scroll", paint, { passive: true });
    }
  })();
</script>
