---
/**
 * Masthead — a survey sheet's title block. Deep field, benchmark disc,
 * wordmark, and an index rule under it in contour brown.
 */
import Logo from "./Logo.astro";
import SectionNav from "./SectionNav.astro";
import NavLinks from "./NavLinks.astro";

---

<header class="field-deep">
  {/* MOBILE IS A DISCLOSURE, DESKTOP IS A ROW.
      Seven links wrapped to two rows at 375px and, with the section bar under
      them, the masthead took a third of the viewport before any content.

      No JavaScript in either. A nav that needs a script to open is a nav that
      can fail shut, and this site does not put content behind a script. */}

  {/* Phone. */}
  <details class="nav-disclosure wrap sm:hidden py-2.5">
    <summary class="list-none flex items-center justify-between gap-3 cursor-pointer text-snow min-h-[44px]">
      <span class="flex items-center gap-2.5">
        <Logo class="w-[2.1rem] h-[2.1rem] shrink-0" />
        <span class="font-display text-[1.05rem] font-semibold tracking-[-0.04em] leading-none">
          Deep Creek Field&nbsp;Guide
        </span>
      </span>
      {/* .label carries its own dim colour, which is unreadable on the deep
          field. Forced to snow, which clears 14:1. */}
      <span class="label text-snow flex items-center gap-1.5 shrink-0">
        Menu
        <svg viewBox="0 0 24 24" class="nav-chevron w-[0.9em] h-[0.9em]" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
          <path d="M4 8l8 8 8-8" />
        </svg>
      </span>
    </summary>

    <nav aria-label="Sections" class="flex flex-col items-start pt-1.5 pb-1">
      <NavLinks />
    </nav>
  </details>

  {/* Everything else. */}
  <div class="wrap hidden sm:flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3">
    <a href="/" class="tap no-underline gap-2.5 text-snow">
      <Logo class="w-[2.1rem] h-[2.1rem] shrink-0" />
      <span class="font-display text-[1.05rem] font-semibold tracking-[-0.04em] leading-none">
        Deep Creek Field&nbsp;Guide
      </span>
    </a>

    <nav aria-label="Sections" class="flex flex-wrap gap-x-3.5 gap-y-0 sm:gap-x-5 items-center justify-end">
      <NavLinks />
    </nav>
  </div>

  {/* Index contour — the heavier every-fifth line on a topo sheet. */}
  <div class="h-[3px] w-full bg-contour"></div>
</header>

<SectionNav />
