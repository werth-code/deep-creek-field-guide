---
/**
 * Field notes.
 *
 * Styled to be unmistakable next to a verified fact: paper-tinted block, mono
 * byline, a rule down the side in lake blue rather than the green a
 * confirmation gets. A reader skimming must never take one of these for
 * something that was checked with an agency.
 */
import type { FieldNote } from "../lib/parks";

interface Props {
  notes: FieldNote[];
}
const { notes } = Astro.props;

const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
const fmt = (iso: string) => {
  const [y, m, d] = iso.split("-").map(Number);
  return `${d} ${MONTHS[m - 1]} ${y}`;
};
const sorted = [...notes].sort((a, b) => b.date.localeCompare(a.date));
---

<section class="my-8" aria-labelledby="field-notes">
  <h2 id="field-notes">Field notes</h2>
  <p class="text-[0.9rem] leading-snug text-ink-soft max-w-[58ch] mt-0">
    What I saw on the day. Not checked with anyone, and it can go out of date
    faster than the facts above.
  </p>

  <ul class="list-none p-0 m-0 mt-5 space-y-4">
    {
      sorted.map((n) => (
        <li class="sheet breakout border-l-[9px] border-l-lake px-4 sm:px-5 py-4">
          {/* ink-soft, not lake: --color-lake is a SURFACE color and runs 5.2:1
              as text, under the 7:1 this site holds itself to. The left rule
              carries the color signal instead, which is the redundant-channel
              approach used everywhere else here. */}
          <p class="stamp text-ink-soft m-0">Field note · {fmt(n.date)} · {n.author}</p>
          <p class="mt-2.5 mb-0 text-[0.98rem] leading-[1.6] max-w-[60ch]">{n.body}</p>
        </li>
      ))
    }
  </ul>
</section>
