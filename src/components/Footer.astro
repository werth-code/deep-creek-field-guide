---
/**
 * Footer — deep field to close the sheet. Carries the method link and the
 * Werth Design credit from page one, because retrofitting either across a
 * built-out site is miserable.
 */
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="field-deep mt-20 no-print">
  <div class="h-[3px] w-full bg-contour"></div>

  <div class="wrap py-11">
    <nav aria-label="Site" class="flex flex-wrap gap-x-7 gap-y-0">
      <a href="/parks/" class="tap text-[0.92rem] text-snow">State parks</a>
      <a href="/parks/regional/" class="tap text-[0.92rem] text-snow">Town parks</a>
      <a href="/ask/" class="tap text-[0.92rem] text-snow">Park finder</a>
      <a href="/about/" class="tap text-[0.92rem] text-snow">Who writes this</a>
      <a href="/how-we-verify/" class="tap text-[0.92rem] text-snow">How I check it</a>
      <a href="/verified/" class="tap text-[0.92rem] text-snow">Verification index</a>
    </nav>

    <div
      class="mt-7 pt-7 border-t border-lake flex flex-wrap items-start justify-between gap-x-8 gap-y-4"
    >
      <p class="m-0 text-[0.86rem] text-snow-soft max-w-[46ch] leading-[1.55]">
        Written and checked by Matt Werth. Everything carries the date I checked
        it.{" "}
        <a href="/how-we-verify/" class="text-snow">The method, and what I've got wrong</a>.
      </p>

      <p class="m-0 stamp text-snow-soft flex items-center gap-2">
        <Logo compact class="w-[1.1rem] h-[1.1rem] shrink-0" />
        © {year} · Built by{" "}
        <a href="https://werth.design" rel="noopener" class="text-snow">Werth Design</a>
      </p>
    </div>
  </div>
</footer>
