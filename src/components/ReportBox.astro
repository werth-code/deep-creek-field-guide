---
/**
 * Field report — "you were just there, tell us what you saw".
 *
 * This is the site's actual growth mechanism. Most of the dataset is marked
 * unconfirmed and the call sheet is 69 items long; someone standing in the
 * car park with a phone can close a gap faster than a round of phone calls
 * can. So the ask goes on EVERY entry, next to the gaps, rather than on a
 * contact page nobody visits.
 *
 * IT IS NOT COMMENTS. Nothing submitted here appears on the site. A report
 * arrives, a person reads it, and if it's usable it becomes a dated fact with
 * `acceptedOn` set — the same bar as anything else. That's why the form says
 * what happens next: a reader who thinks they're posting publicly will write
 * something different from one who knows they're filing a correction.
 *
 * Works with no endpoint configured: falls back to a prefilled mailto, which
 * needs no service, no JavaScript and no third party. Set
 * PUBLIC_REPORT_ENDPOINT to a form service (Formspree, Basin) to collect them
 * properly.
 */
interface Props {
  /** What is being reported on, e.g. "Swallow Falls". */
  subject: string;
  /** Path of the page, so a report can be traced back to what it was about. */
  path: string;
  /** The specific open questions, offered as one-tap answers. */
  gaps?: string[];
}

const { subject, path, gaps = [] } = Astro.props;

const endpoint = import.meta.env.PUBLIC_REPORT_ENDPOINT ?? "";
const mailto = `mailto:reports@deepcreekfieldguide.com?subject=${encodeURIComponent(
  `Field report: ${subject}`,
)}&body=${encodeURIComponent(
  `What I saw:\n\n\nWhen I was there (date):\n\n\nAbout: ${subject} (${path})\n`,
)}`;

const id = `report-${path.replace(/[^a-z0-9]+/gi, "-")}`;
---

<section class="sheet breakout my-8 px-4 sm:px-5 py-5 border-l-[9px] border-l-contour-deep" aria-labelledby={`${id}-h`}>
  <p class="label m-0 text-contour-deep">Were you just there?</p>
  <h2 id={`${id}-h`} class="font-display text-[1.3rem] font-semibold tracking-[-0.03em] mt-2 mb-0 text-slate max-w-[26ch]">
    Tell us what you saw
  </h2>
  <p class="mt-2.5 mb-0 text-[0.95rem] leading-[1.55] max-w-[58ch]">
    {
      gaps.length > 0
        ? "You can answer one of these in ten seconds, and it's worth more than another phone call."
        : "If something here is wrong or has changed, this is the fastest way to fix it."
    }
  </p>

  {
    gaps.length > 0 && (
      <ul class="list-none p-0 m-0 mt-3.5 space-y-1.5">
        {gaps.slice(0, 4).map((g) => (
          <li class="text-[0.9rem] leading-snug text-ink-soft flex gap-2">
            <span class="text-contour-deep shrink-0" aria-hidden="true">?</span>
            <span>{g}</span>
          </li>
        ))}
      </ul>
    )
  }

  <form
    class="mt-4"
    method="POST"
    action={endpoint || undefined}
    data-report-form={endpoint ? "" : undefined}
  >
    <input type="hidden" name="page" value={path} />
    <input type="hidden" name="subject" value={subject} />
    {/* Bot trap. A real person never fills a hidden field. */}
    <p class="hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </p>

    <label class="label block" for={`${id}-what`}>What did you see?</label>
    <textarea
      id={`${id}-what`}
      name="report"
      rows="3"
      required
      maxlength="1200"
      placeholder="The restrooms by the boat launch were open and clean."
      class="block w-full max-w-full min-w-0 mt-1.5 bg-paper border-2 border-slate px-3 py-2.5 text-[16px] sm:text-[0.98rem] text-ink placeholder:text-ink-soft focus:outline-none focus:ring-2 focus:ring-contour"
    ></textarea>

    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <div class="min-w-0">
        <label class="label block" for={`${id}-when`}>When were you there?</label>
        <input
          id={`${id}-when`}
          name="visited"
          type="date"
          required
          class="block w-full max-w-full min-w-0 mt-1.5 bg-paper border-2 border-slate px-3 py-2.5 text-[16px] sm:text-[0.98rem] text-ink focus:outline-none focus:ring-2 focus:ring-contour"
        />
      </div>
      <div class="min-w-0">
        <label class="label block" for={`${id}-email`}>Email <span class="normal-case tracking-normal text-ink-soft">(optional)</span></label>
        <input
          id={`${id}-email`}
          name="email"
          type="email"
          maxlength="120"
          placeholder="Only if we may ask a follow-up"
          class="block w-full max-w-full min-w-0 mt-1.5 bg-paper border-2 border-slate px-3 py-2.5 text-[16px] sm:text-[0.98rem] text-ink placeholder:text-ink-soft focus:outline-none focus:ring-2 focus:ring-contour"
        />
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button
        type="submit"
        class="tap bg-slate text-snow border-2 border-slate px-5 py-2.5 font-mono text-[0.78rem] uppercase tracking-[0.1em] font-medium hover:bg-ink"
      >
        Send report
      </button>
      {
        !endpoint && (
          <a href={mailto} class="stamp text-ink-soft">or email it instead</a>
        )
      }
    </div>

    <p class="mt-3.5 mb-0 text-[0.83rem] leading-snug text-ink-soft max-w-[58ch]">
      Reports aren't published. A person reads yours, and if we can use it, it
      becomes a dated fact on this page with the date you saw it —
      <a href="/how-we-verify/">the same bar as everything else</a>. We don't
      post your name or your email.
    </p>

    <p class="mt-3 mb-0 text-[0.86rem] hidden" data-report-status role="status"></p>
  </form>
</section>

{
  endpoint && (
    <script>
      // Submit in place so the reader isn't thrown to a third-party thank-you
      // page. Falls back to a normal form POST if fetch fails.
      document.querySelectorAll("form[data-report-form]").forEach((form) => {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const status = form.querySelector("[data-report-status]");
          const button = form.querySelector("button[type=submit]");
          const say = (msg, ok) => {
            status.textContent = msg;
            status.classList.remove("hidden");
            status.classList.toggle("text-flag-green-bearing", ok);
            status.classList.toggle("text-flag-red-bearing", !ok);
          };
          button.disabled = true;
          say("Sending…", true);
          try {
            const res = await fetch(form.action, {
              method: "POST",
              body: new FormData(form),
              headers: { Accept: "application/json" },
            });
            if (!res.ok) throw new Error("bad status");
            form.querySelectorAll("textarea, input[type=date], input[type=email]").forEach((el) => (el.value = ""));
            say("Thank you — that's with us. We'll check it and date it.", true);
          } catch {
            say("That didn't send. Please try again, or email us.", false);
            button.disabled = false;
          }
        });
      });
    </script>
  )
}
