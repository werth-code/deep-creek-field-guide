---
/**
 * One state park.
 *
 * Reservation status leads, because at Swallow Falls it's the difference
 * between a day out and a three-hour drive for nothing.
 */
import type { GetStaticPaths } from "astro";

import Layout from "../../layouts/Layout.astro";
import FlagIcon from "../../components/FlagIcon.astro";
import MapLink from "../../components/MapLink.astro";
import MapEmbed from "../../components/MapEmbed.astro";
import Photo from "../../components/Photo.astro";
import Verdict from "../../components/Verdict.astro";
import FieldNotes from "../../components/FieldNotes.astro";
import ReportBox from "../../components/ReportBox.astro";
import FeatureIcon from "../../components/FeatureIcon.astro";

import parksData from "../../data/state-parks.json";
import {
  STATE_FEATURE_LABELS,
  asksForState,
  completenessState,
  reservationFlag,
  reservationLine,
  tri,
  type StatePark,
} from "../../lib/parks";
import { isPublishable, isVerified, reportOutstanding, robotsFor, sourcedText, stampText, tierOf } from "../../lib/verification";
import { formatStampDate } from "../../lib/dates";
import { colorFor } from "../../lib/feature-colors";

export const getStaticPaths = (() =>
  (parksData as StatePark[]).map((park) => ({ params: { slug: park.slug }, props: { park } }))) satisfies GetStaticPaths;

const { park } = Astro.props as { park: StatePark };
reportOutstanding(`parks/${park.slug}`, park);

const { known, total } = completenessState(park);
const flag = reservationFlag(park.reservation);
const line = reservationLine(park.reservation);
const tier = tierOf(park);
const publishable = isPublishable(park);

const others = (parksData as StatePark[]).filter((p) => p.slug !== park.slug).slice(0, 6);

const schema = publishable
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Park",
        name: `${park.name} ${park.kind}`,
        description: park.blurb,
        address: { "@type": "PostalAddress", addressLocality: park.town, addressRegion: "MD" },
      },
    ]
  : [];

const base =
  `${park.name} ${park.kind} near Deep Creek Lake, Maryland. ` +
  (park.reservation.required === true
    ? (park.reservation.scope === "weekends"
        ? "Weekends need a reservation, weekdays don't. "
        : "Do you need a reservation? Yes, and here are the days. ")
    : "Fees, restrooms, and what's actually there. ") +
  "Every fact dated, with the gaps marked.";
const description = base.length < 118 ? `${base} Part of the Deep Creek Field Guide.` : base;

/* Longest title that still fits the SERP. Some of these names are long enough
   ("Youghiogheny Wild River Natural Environment Area") that even the short
   form clips, so the last candidate drops the kind entirely. */
/* "Swallow Falls State park" reads as a typo in a browser tab, even though
   it's correct in running text after the park's name. */
const Kind = park.kind.replace(/\b[a-z]/g, (c) => c.toUpperCase());
/* "Deep Creek Lake" is what people type; "Garrett County" is the
   administrative name and gets searched far less. Lake first, county as the
   fallback when the name is already long. */
const title =
  [
    `${park.name} ${Kind} — Deep Creek Lake, MD`,
    `${park.name} ${Kind} near Deep Creek Lake`,
    `${park.name} ${Kind}, Garrett County MD`,
    `${park.name}, Deep Creek Lake, Maryland`,
    `${park.name} — Garrett County, Maryland`,
    park.name,
  ].find((t) => t.length >= 25 && t.length <= 60)
  ?? [`${park.name} ${Kind}, Garrett County MD`, park.name].find((t) => t.length <= 60)
  ?? park.name;
---

<Layout
  title={title}
  description={description.slice(0, 157)}
  robots={robotsFor(park)}
  dateModified={park.verifiedDate ?? park.sourcedOn}
  schema={schema}
>
  <article>
    <div class="wrap pt-11 pb-6">
      <p class="label m-0">
        <a href="/parks/" class="no-underline hover:underline">State parks</a>
        <span class="text-ink-soft"> · </span>{park.town}
      </p>
      <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[16ch] text-slate">{park.name}</h1>
      <p class="stamp text-ink-soft mt-3 mb-0">
        {park.kind}{park.acres ? ` · ${park.acres.toLocaleString()} acres` : ""}
      </p>
    </div>

    {/* Reservation status — the thing that decides the trip. */}
    <div class="wrap">
      <section class="sheet breakout overflow-hidden my-2" aria-label="Reservation status">
        <div class={`${flag.bar} h-3 w-full`}></div>
        <div class="px-4 sm:px-5 py-4">
          <span
            class={`${flag.chip} inline-flex items-center gap-2 px-3 py-1.5 border-2 border-ink font-mono text-[0.74rem] font-medium uppercase tracking-[0.1em]`}
          >
            <FlagIcon icon={flag.icon} class="w-[1.05em] h-[1.05em]" />
            {flag.word}
          </span>

          {/* One sentence, built from the data by reservationLine().
              This used to be a display-type headline reading "You can't just
              turn up" over a three-column grid. Both were true of weekends
              and read as true of every day — someone checking on a Wednesday
              would have driven somewhere else for nothing. The badge now
              carries the scope and this carries the detail. */}
          {line && (
            <p class="mt-3 mb-0 text-[0.95rem] leading-[1.55] max-w-[60ch]">{line}</p>
          )}

          {park.reservation.slots && park.reservation.slots.length > 0 && (
            <div class="mt-4">
              <p class="label m-0">Entry slots</p>
              <ul class="list-none p-0 m-0 mt-2 flex flex-wrap gap-1.5">
                {park.reservation.slots.map((s) => (
                  <li class="sheet-quiet px-2.5 py-1 stamp text-slate">{s}</li>
                ))}
              </ul>
            </div>
          )}

          {park.reservation.note && (
            <p class="mt-3.5 mb-0 text-[0.93rem] leading-[1.55] max-w-[58ch]">{park.reservation.note}</p>
          )}
        </div>
      </section>
    </div>

    {
      park.warnings.length > 0 && (
        <div class="wrap">
          <aside class="sheet breakout border-l-[9px] border-l-flag-red px-4 sm:px-5 py-4 my-4">
            <p class="label text-flag-red-bearing m-0 flex items-center gap-1.5">
              <FlagIcon icon="alert" class="w-[1em] h-[1em]" />
              Before you go
            </p>
            <ul class="list-none p-0 m-0 mt-2 space-y-1.5">
              {park.warnings.map((w) => (
                <li class="text-[0.96rem] leading-[1.5] max-w-[56ch]">{w}</li>
              ))}
            </ul>
          </aside>
        </div>
      )
    }

    <div class="wrap prose-field pt-4">
      <p class="text-[1.15rem] leading-[1.5] max-w-[56ch]">{park.blurb}</p>

      {park.verdict && <Verdict verdict={park.verdict} />}

      {park.photos && park.photos.length > 0 && <Photo {...park.photos[0]} hero />}

      <h2>What's there</h2>
      <div class="sheet breakout my-6 p-4 sm:p-5">
        <div class="flex items-baseline justify-between gap-4">
          <p class="label m-0">Facilities</p>
          <span class="stamp text-ink-soft">{known}/{total} confirmed</span>
        </div>
        <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-0 mt-3.5 mb-0 border-t-2 border-contour">
          {
            STATE_FEATURE_LABELS.map(([key, label]) => {
              const v = tri(park.features[key]);
              return (
                <div class="border-b border-lake/30 py-2.5">
                  {/* Colour ONLY on a confirmed yes. A feature that is
                      confirmed ABSENT was getting its full identity color
                      here, so "Surf fishing — No" looked at a glance exactly
                      like a yes. The word said no and the color said yes.

                      Same glyph and same color the chip uses on the index.
                      A reader who learnt "blue slide = playground" from a card
                      should meet it again here rather than a bare word. Dimmed
                      when the field is unconfirmed, so the row still reads as
                      an unknown at a glance. */}
                  <dt class="label flex items-center gap-1.5">
                    <FeatureIcon
                      icon={key as any}
                      class="w-[1.15em] h-[1.15em] shrink-0"
                      style={v.state === "yes" ? `color:${colorFor(key)}` : "color:var(--color-ink-soft);opacity:.4"}
                    />
                    {label}
                  </dt>
                  <dd
                    class={`m-0 mt-0.5 text-[0.93rem] ${v.state === "unknown" ? "text-ink-soft italic" : "text-ink"}`}
                  >
                    {v.text}
                  </dd>
                </div>
              );
            })
          }
        </dl>
      </div>

      <h2>Getting in</h2>

      {/* Maryland charges PER PERSON in summer and PER VEHICLE off-season at
          the parks that charge at all, which is the detail that surprises a
          carful of five. Worth a table rather than a sentence. */}
      {
        park.fee.schedule && park.fee.schedule.length > 0 && (
          <div class="sheet breakout my-6 overflow-x-auto">
            <table class="w-full border-collapse text-left min-w-[30rem]">
              <thead>
                <tr class="border-b-2 border-contour">
                  <th class="label px-4 py-3 font-normal">When</th>
                  <th class="label px-4 py-3 font-normal whitespace-nowrap">Maryland residents</th>
                  <th class="label px-4 py-3 font-normal whitespace-nowrap">Out of state</th>
                </tr>
              </thead>
              <tbody>
                {park.fee.schedule.map((row) => (
                  <tr class="border-b border-lake/25 align-top">
                    <td class="px-4 py-3 text-[0.92rem] leading-snug">{row.when}</td>
                    <td class="px-4 py-3 text-[0.92rem] whitespace-nowrap font-medium">{row.resident}</td>
                    <td class="px-4 py-3 text-[0.92rem] whitespace-nowrap font-medium">{row.nonResident}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }

      <dl class="sheet breakout my-6 divide-y-2 divide-lake/25">
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Fee</dt>
          <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55]">{park.fee.note}</dd>
        </div>
        {
          park.fee.passes && (
            <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
              <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Annual pass</dt>
              <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55]">{park.fee.passes}</dd>
            </div>
          )
        }
        {
          park.services && (
            <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
              <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Shop</dt>
              <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem] leading-[1.55]">
                {(() => {
                  /* Two separate fields, because "there is a park store" and
                     "it sells souvenirs" are different claims and we often
                     only have the first. */
                  const s = park.services!;
                  if (s.giftShop === true) return "Gift shop on site";
                  if (s.campStore === true)
                    return "Park store on site — whether it stocks more than camp supplies isn't confirmed";
                  if (s.giftShop === false && s.campStore === false) return "No shop on site";
                  return <span class="text-ink-soft italic">Not confirmed</span>;
                })()}
              </dd>
            </div>
          )
        }
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Hours</dt>
          <dd class={`m-0 mt-1 sm:mt-0 text-[0.95rem] ${park.hours ? "" : "text-ink-soft italic"}`}>
            {park.hours ?? "Not confirmed"}
          </dd>
        </div>
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Park office</dt>
          <dd class="m-0 mt-1 sm:mt-0 text-[0.95rem]">
            {park.services?.officePhone || park.phone ? (
              <a
                href={`tel:${(park.services?.officePhone ?? park.phone ?? "").replace(/[^0-9+]/g, "")}`}
                class="tap stamp text-[1rem]"
              >
                {park.services?.officePhone ?? park.phone}
              </a>
            ) : (
              <span class="text-ink-soft italic">Not confirmed</span>
            )}
            {park.services?.parkOffice && (
              <span class="block text-[0.88rem] text-ink-soft mt-1 leading-snug">
                {park.services.parkOffice}
                {park.services.officeAddress ? ` — ${park.services.officeAddress}` : ""}
              </span>
            )}
            {park.services?.note && (
              <span class="block text-[0.86rem] text-ink-soft mt-1 leading-snug">{park.services.note}</span>
            )}
          </dd>
        </div>
        <div class="px-4 sm:px-5 py-3 sm:flex sm:gap-6">
          <dt class="label sm:w-[9rem] sm:shrink-0 sm:pt-1">Getting there</dt>
          <dd class="m-0 mt-1 sm:mt-0">
            {/* Include the kind: "Swallow Falls" alone is ambiguous, "Swallow
                Falls State Park" is not. */}
            <MapLink name={`${park.name} ${park.kind}`} town={park.town} label="Open in Google Maps" />
          </dd>
        </div>
      </dl>

      {
        park.photos && park.photos.length > 1 && (
          <>
            <h2>More photographs</h2>
            {park.photos.slice(1).map((ph) => <Photo {...ph} />)}
          </>
        )
      }

      {/* Field reports sit ABOVE the sourcing too. Someone who was standing
          there is a real form of evidence, and burying it under the agency
          links would imply otherwise — but the wording has to keep it clearly
          distinct from "the agency told us", which is a different claim. */}
      {
        park.reports && park.reports.length > 0 && (
          <>
            <h2 id="reports">From people who were there</h2>
            <ul class="list-none p-0 m-0 space-y-4">
              {park.reports.map((r) => (
                <li class="sheet px-4 sm:px-5 py-4 border-l-[9px] border-l-lake">
                  <p class="m-0 text-[0.96rem] leading-[1.55] max-w-[58ch]">{r.what}</p>
                  <p class="stamp text-ink-soft mt-2.5 mb-0">
                    {r.from} · reported {formatStampDate(r.receivedOn)}
                    {r.visitedOn
                      ? ` · visited ${formatStampDate(r.visitedOn)}`
                      : " · visit date not given"}
                  </p>
                  {r.affects && r.affects.length > 0 && (
                    <p class="stamp text-ink-soft mt-1 mb-0">Bears on: {r.affects.join(", ")}</p>
                  )}
                </li>
              ))}
            </ul>
            <p class="text-[0.86rem] leading-snug text-ink-soft max-w-[58ch]">
              First-hand and useful, but not the same as the agency confirming it —
              so it doesn't change the stamp below. It changes what I go and ask.
            </p>
          </>
        )
      }

      {/* Corrections run ABOVE the provenance block and above "still to confirm".
          Burying a correction under the sourcing would be a way of technically
          keeping the promise while hoping nobody reads it. */}
      {
        park.corrections && park.corrections.length > 0 && (
          <>
            <h2 id="corrected">I got this wrong</h2>
            <ul class="list-none p-0 m-0 space-y-4">
              {park.corrections.map((c) => (
                <li class="sheet px-4 sm:px-5 py-4 border-l-[9px] border-l-contour-deep">
                  <p class="label text-contour-deep m-0">
                    Corrected {formatStampDate(c.date)}
                  </p>
                  <p class="mt-2 mb-0 text-[0.94rem] leading-[1.55] max-w-[58ch]">
                    <span class="font-medium">I'd said:</span> {c.was}
                  </p>
                  <p class="mt-1.5 mb-0 text-[0.94rem] leading-[1.55] max-w-[58ch]">
                    <span class="font-medium">Actually:</span> {c.now}
                  </p>
                </li>
              ))}
            </ul>
          </>
        )
      }

      {/* Provenance. */}
      <aside class={`sheet breakout my-8 px-4 sm:px-5 py-5 border-l-[9px] ${isVerified(park) ? "border-l-flag-green" : "border-l-contour"}`}>
        {
          isVerified(park) ? (
            <p class="m-0"><span class="stamp stamp-struck">{stampText(park)}</span></p>
          ) : tier === "sourced" ? (
            <>
              <p class="label text-contour-deep m-0">Read from the source — not yet confirmed by phone</p>
              <p class="stamp text-ink-soft mt-1.5 mb-0">{sourcedText(park)}</p>
            </>
          ) : (
            <p class="stamp text-ink-soft m-0">Not yet checked against a primary source.</p>
          )
        }

        <ul class="list-none p-0 mt-4 mb-0 space-y-1.5">
          {park.sources.map((s) => (
            <li class="text-[0.88rem] leading-snug">
              <a href={s.url} rel="nofollow">{s.label}</a>
              {s.note && <span class="text-ink-soft"> — {s.note}</span>}
            </li>
          ))}
        </ul>

        <p class="mt-4 mb-0 text-[0.85rem] text-ink-soft max-w-[56ch]">
          Rules change. If you find this wrong,{" "}
          <a href="/how-we-verify/#corrections">tell me and I'll fix it and say I did</a>.
        </p>
      </aside>

      {/* The internal to-do list used to render here as "Still to confirm".
          It was written for whoever makes the phone calls — "PRIORITY: get the
          admission price" — and putting that in front of a visitor asks them
          to care about our workflow. They don't; they wanted the answer too.
          It lives in CALL-SHEET.md now, and the reader gets the same gaps as
          tappable questions in the report box below. Every unconfirmed field
          still reads "Not confirmed" where it sits, which is the honest signal
          that actually helps. */}

      <h2>Where it's</h2>
      <MapEmbed name={`${park.name} ${park.kind}`} town={park.town} address={null} />

      {park.fieldNotes && park.fieldNotes.length > 0 && <FieldNotes notes={park.fieldNotes} />}

      <ReportBox subject={park.name} path={`/parks/${park.slug}/`} asks={asksForState(park)} />

      <h2>The other parks</h2>
      <ul>
        {
          others.map((p) => (
            <li>
              <a href={`/parks/${p.slug}/`}>{p.name}</a>
              <span class="stamp text-ink-soft">
                {" — "}{p.kind.toLowerCase()}, {p.town}
                {p.reservation.required === true ? " · reservation required" : ""}
              </span>
            </li>
          ))
        }
        <li><a href="/parks/">All ten, side by side</a></li>
      </ul>
    </div>
  </article>
</Layout>
