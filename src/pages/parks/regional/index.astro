---
/**
 * Town parks — the municipal ones, as opposed to the ten state parks.
 *
 * The structure here is genuinely different from a suburban county: Garrett
 * County itself owns only four park sites, and its "recreation facilities" are
 * school grounds run by the Board of Education. The real inventory belongs to
 * eight small towns. The page says so, because a reader expecting a county
 * parks department will otherwise think we missed something.
 *
 * Restrooms lead every card. It's the question people ask before loading a car
 * and almost nobody publishes it.
 */
import Layout from "../../../layouts/Layout.astro";
import Ethics from "../../../components/Ethics.astro";
import FlagIcon from "../../../components/FlagIcon.astro";
import CardPhoto from "../../../components/CardPhoto.astro";

import parksData from "../../../data/regional-parks.json";
import {
  completenessRegional,
  presentRegional,
  restroomAnswer,
  type RegionalPark,
} from "../../../lib/parks";
import { isPublishable, robotsFor } from "../../../lib/verification";

const parks = parksData as RegionalPark[];
const live = parks.filter(isPublishable);
const gate = {
  verifiedDate: null,
  verifiedSource: null,
  sources: live.length ? [{ label: "x", url: "x" }] : null,
  sourcedOn: live.length ? "2026-08-03" : null,
};

const withRestrooms = parks.filter((p) => p.restrooms.present === true).length;
const unknownRestrooms = parks.filter((p) => p.restrooms.present === null).length;

/* Detailed records first, name-only stubs last — a reader shouldn't have to
   scroll past five placeholders to reach the park with a beach on it. */
const ranked = [...parks].sort(
  (a, b) => completenessRegional(b).known - completenessRegional(a).known,
);
---

<Layout
  title="Garrett County town parks — do they have restrooms?"
  description="The municipal parks around Deep Creek Lake: restrooms, playgrounds, beaches and pavilions. Small-town parks nobody else documents, with the gaps marked."
  robots={robotsFor(gate)}
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">
      <a href="/parks/" class="no-underline hover:underline">Parks</a>
      <span class="text-ink-soft"> · </span>Town parks
    </p>
    <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[16ch] text-slate">
      Are there restrooms?
    </h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      Playgrounds, ball fields, one lake beach. The small stuff, answered on the
      questions you actually ask before loading the car. These aren't the state
      parks. <a href="/parks/">Those are over here</a>.
    </p>
  </div>

  <div class="wrap prose-field pb-2">
    <h2>These belong to the towns, not the county</h2>
    <p class="max-w-[58ch]">
      Garrett County owns four park sites. Four. Most of what gets called
      "county recreation" is actually school grounds run by the Board of
      Education.
    </p>

    <p class="max-w-[58ch]">
      So the parks people use belong to eight small towns: Accident,
      Friendsville, Grantsville, Kitzmiller, Oakland, Deer Park, Mountain Lake
      Park and Loch Lynn Heights. Each with its own budget and its own hours.
      And nobody had put any of it in one place.
    </p>

    <div class="sheet breakout my-6 px-4 sm:px-5 py-4">
      <p class="label m-0">Where this dataset stands</p>
      <dl class="grid grid-cols-3 gap-4 mt-3 mb-0">
        {
          [
            { n: parks.length, label: "parks listed" },
            { n: withRestrooms, label: "restrooms confirmed" },
            { n: unknownRestrooms, label: "still unchecked" },
          ].map((s) => (
            <div>
              <dt class="font-display text-[2rem] font-semibold text-slate leading-none">{s.n}</dt>
              <dd class="m-0 mt-1 stamp text-ink-soft">{s.label}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3.5 mb-0 text-[0.9rem] leading-snug text-ink-soft max-w-[56ch]">
        That's where it honestly stands. A couple of these are still name-only:
        towns the county says have parks, where I don't yet know which park or
        what's in it. They're listed anyway so you can see the hole.
      </p>
    </div>
  </div>

  <div class="wrap pb-8">
    <div class="grid gap-4 sm:grid-cols-2 breakout">
      {
        ranked.map((park) => {
          const { known, total } = completenessRegional(park);
          const wc = restroomAnswer(park.restrooms);
          const has = presentRegional(park);
          return (
            <article data-reveal class="sheet sheet-action relative group">
              <a href={`/parks/regional/${park.slug}/`} class="absolute inset-0 z-10 no-underline">
                <span class="sr-only">{park.name}</span>
              </a>

              {park.photos?.[0] && <CardPhoto {...park.photos[0]} />}

              <div class="p-4 sm:p-5">
                <header class="flex items-start justify-between gap-3">
                  <div>
                    <h2 class="font-display text-[1.12rem] font-semibold tracking-[-0.03em] m-0 text-slate underline decoration-contour decoration-2 underline-offset-[0.16em] group-hover:decoration-slate">
                      {park.name}
                    </h2>
                    <p class="stamp text-ink-soft mt-1 mb-0">{park.operator}</p>
                  </div>
                  <span class="stamp text-ink-soft shrink-0">{known}/{total}</span>
                </header>

                {/* Restrooms first, always, and visually separated. */}
                <div class="mt-3.5 border-y-2 border-contour py-2.5 flex items-baseline justify-between gap-3">
                  <span class="label">Restrooms</span>
                  <span
                    class={`text-[0.92rem] text-right ${wc.state === "unknown" ? "text-ink-soft italic" : "text-ink font-medium"}`}
                  >
                    {wc.text}
                  </span>
                </div>

                <p class="mt-3 mb-0 text-[0.9rem] leading-[1.55]">{park.blurb}</p>

                {has.length > 0 && (
                  <ul class="list-none p-0 m-0 mt-3.5 flex flex-wrap gap-1.5">
                    {has.map((f) => (
                      <li class="sheet-quiet px-2 py-0.5 stamp text-[0.68rem] text-slate">{f}</li>
                    ))}
                  </ul>
                )}

                {park.warnings.length > 0 && (
                  <p class="mt-3 mb-0 text-[0.85rem] leading-snug text-ink-soft flex gap-1.5">
                    <FlagIcon icon="alert" class="w-[1em] h-[1em] mt-1 shrink-0 text-flag-red" />
                    <span>{park.warnings[0]}</span>
                  </p>
                )}

                <p class="stamp text-ink-soft mt-3.5 mb-0 flex items-center justify-between gap-3">
                  <span>{park.town}</span>
                  <span class="text-contour-deep group-hover:translate-x-0.5 transition-transform duration-100">→</span>
                </p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>

  <div class="wrap prose-field pb-4">
    <Ethics />

    <h2>Related</h2>
    <ul>
      <li><a href="/parks/">The ten state parks and forests</a></li>
      <li><a href="/verified/">Every fact on the site, with its source and age</a></li>
      <li><a href="/how-we-verify/">How I check this</a></li>
    </ul>
  </div>
</Layout>
