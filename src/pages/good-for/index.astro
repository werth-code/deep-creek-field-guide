---
/**
 * All the situations. A front door for people who know what kind of afternoon
 * they want and not which park delivers it.
 */
import Layout from "../../layouts/Layout.astro";
import stateParksData from "../../data/state-parks.json";
import regionalParksData from "../../data/regional-parks.json";
import { allGoodFor, type StatePark, type RegionalPark } from "../../lib/parks";

const tags = allGoodFor(stateParksData as StatePark[], regionalParksData as RegionalPark[]);
---

<Layout
  title="Good for — pick the afternoon, not the park"
  description="Deep Creek Lake parks sorted by what you actually want: restrooms that exist, no booking needed, somewhere to sit, get in the water. Every tag confirmed."
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Good for</p>
    <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[15ch] text-slate">
      Pick the afternoon
    </h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      Most days you don't want a park. You want somewhere with a toilet, or
      somewhere free, or somewhere you can turn up to without booking. So the
      lists are sorted that way.
    </p>
  </div>

  <div class="wrap pb-9">
    <ul class="list-none p-0 m-0 grid gap-3 sm:grid-cols-2 breakout">
      {
        tags.map((t, i) => (
          <li data-reveal style={`--stagger:${Math.min(i, 7)}`}>
            <a href={`/good-for/${t.slug}/`} class="sheet sheet-action block p-4 sm:p-5 no-underline h-full group">
              <p class="font-display text-[1.35rem] font-semibold tracking-[-0.03em] m-0 text-slate underline decoration-contour decoration-2 underline-offset-[0.16em] group-hover:decoration-slate">
                {t.label}
              </p>
              <p class="stamp text-ink-soft mt-2 mb-0">
                {t.parks.length} {t.parks.length === 1 ? "park" : "parks"}, confirmed
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="wrap prose-field pb-4">
    <h2>Why these and not "hidden gems"</h2>
    <p class="max-w-[58ch]">
      Because these are the things people actually decide on. Nobody drives an
      hour for a hidden gem. They drive for somewhere the kids can run about
      that has a toilet, and they'd like to know before setting off.
    </p>
    <h2>Related</h2>
    <ul>
      <li><a href="/parks/">All the state parks</a></li>
      <li><a href="/ask/">Ask for something specific</a></li>
    </ul>
  </div>
</Layout>
