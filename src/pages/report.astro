---
/**
 * Send a report, with photographs.
 *
 * The report boxes on each record page take a sentence. This takes a sentence
 * and up to four photographs, because a photograph settles arguments that a
 * sentence can't — whether the path is really stroller-doable, whether the
 * restroom block is open, whether the gate is where the map says.
 *
 * NOTHING SENT HERE IS PUBLISHED BY SENDING IT. It lands in a bucket and waits
 * for a person. Photos that get used go through the same import pipeline as
 * every other photograph on the site, and the text becomes a dated field note
 * with `acceptedOn` set. The page says so plainly, because a reader who thinks
 * they're posting publicly writes something different from one who knows
 * they're filing a correction.
 *
 * THE BROWSER RESIZES BEFORE UPLOADING, and that isn't a nicety. Cloudflare's
 * free Workers plan allows 10ms of CPU per request; decoding a 12-megapixel
 * phone photo server-side would blow through it and force a paid plan to do
 * something the browser does for nothing. A canvas resize to 1600px also means
 * a report from a parking lot with one bar of signal actually completes.
 *
 * WITHOUT JAVASCRIPT it is a plain multipart form that posts to the same
 * endpoint and gets redirected to a thank-you page. Full-size photos, slower,
 * still works. And with no endpoint configured at all it falls back to a
 * prefilled mailto, so the page is never a dead end.
 */
import Layout from "../layouts/Layout.astro";
import FlagIcon from "../components/FlagIcon.astro";

const endpoint = import.meta.env.PUBLIC_REPORT_ENDPOINT ?? "";

const mailto = `mailto:reports@deepcreekfieldguide.com?subject=${encodeURIComponent(
  "Field report",
)}&body=${encodeURIComponent(
  "What I saw:\n\n\nWhere (park or place):\n\n\nWhen I was there (date):\n\n\n(Attach photos to this email if you have them.)\n",
)}`;
---

<Layout
  title="Send a field report — Deep Creek Field Guide"
  description="Tell me what you saw, and send photographs. Reports are read by a person and become dated facts with a source. Nothing posts automatically."
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Field report</p>
    <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[15ch] text-slate">
      Tell me what you saw
    </h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      You standing in the parking lot beats another phone call from me. If
      something here is wrong, or a gate has moved, or a restroom is shut, this
      is the fastest way to fix it.
    </p>
  </div>

  <div class="wrap pb-6">
    <div class="sheet breakout px-4 sm:px-5 py-4 border-l-[9px] border-l-contour-deep">
      <p class="label m-0 text-contour-deep">Before you write</p>
      <p class="mt-2 mb-0 text-[0.95rem] leading-[1.55] max-w-[58ch]">
        This is not a comment box and nothing you send appears on the site by
        sending it. A person reads it. If it holds up, it becomes a dated entry
        with your name on it if you give one, and the fact it corrects gets
        re-checked. If it doesn't, nothing happens and nobody sees it.
      </p>
    </div>
  </div>

  {
    endpoint ? (
      <div class="wrap pb-8">
        <form
          id="report-form"
          class="sheet breakout p-4 sm:p-5"
          method="POST"
          action={endpoint}
          enctype="multipart/form-data"
        >
          <input type="hidden" name="site" value="deepcreek" />

          {/* Honeypot. Off-screen rather than display:none, which some bots
              check for, and never focusable by tab. */}
          <div aria-hidden="true" style="position:absolute;left:-9999px;top:0;height:0;overflow:hidden">
            <label for="hp">Leave this empty</label>
            <input id="hp" name="hp" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <label class="label block" for="what">What you saw *</label>
          <textarea
            id="what"
            name="what"
            required
            minlength="10"
            maxlength="4000"
            rows="5"
            placeholder="The restroom block at the day-use lot was locked on Saturday, and the sign on the door said it reopens in May."
            class="mt-2 w-full bg-paper border-2 border-slate px-3 py-2.5 text-[1rem] text-ink placeholder:text-ink-soft focus:outline-none focus:ring-2 focus:ring-contour"
          />

          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <label class="label block" for="subject">Which place</label>
              <input
                id="subject"
                name="subject"
                type="text"
                maxlength="120"
                placeholder="Swallow Falls"
                class="mt-2 w-full bg-paper border-2 border-slate px-3 py-2.5 text-[1rem]"
              />
            </div>
            <div>
              <label class="label block" for="visited">When you were there</label>
              <input
                id="visited"
                name="visited"
                type="date"
                class="mt-2 w-full bg-paper border-2 border-slate px-3 py-2.5 text-[1rem]"
              />
            </div>
          </div>

          <div class="mt-4">
            <label class="label block" for="photos">Photos — up to four</label>
            <p class="stamp text-ink-soft mt-1 mb-0">
              Resized in your browser before they're sent, so this works on one
              bar of signal. Location data is stripped from anything published.
            </p>
            <input
              id="photos"
              name="photos"
              type="file"
              accept="image/jpeg,image/png,image/webp"
              multiple
              class="mt-2 w-full text-[0.9rem]"
            />
            <p class="stamp text-ink-soft mt-1.5 mb-0" data-photo-note hidden />
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <label class="label block" for="name">Your name — optional</label>
              <input
                id="name"
                name="name"
                type="text"
                maxlength="80"
                autocomplete="name"
                class="mt-2 w-full bg-paper border-2 border-slate px-3 py-2.5 text-[1rem]"
              />
            </div>
            <div>
              <label class="label block" for="email">Email — optional</label>
              <input
                id="email"
                name="email"
                type="email"
                maxlength="120"
                autocomplete="email"
                class="mt-2 w-full bg-paper border-2 border-slate px-3 py-2.5 text-[1rem]"
              />
            </div>
          </div>
          <p class="stamp text-ink-soft mt-1.5 mb-0">
            The email is only so I can come back with a question. It is never
            shown on the site and never used for anything else.
          </p>

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button
              type="submit"
              class="tap bg-slate text-snow border-2 border-slate px-5 py-2.5 font-mono text-[0.78rem] uppercase tracking-[0.1em] font-medium hover:bg-ink"
            >
              Send it
            </button>
            <p class="stamp text-ink-soft m-0" data-status aria-live="polite" />
          </div>
        </form>
      </div>
    ) : (
      <div class="wrap pb-8">
        <div class="sheet breakout px-4 sm:px-5 py-5">
          <p class="label m-0">Not wired up yet</p>
          <p class="mt-2 mb-3 text-[0.95rem] leading-[1.55] max-w-[58ch]">
            The upload endpoint isn't configured on this build, so the form
            would post into nothing. Email works in the meantime and takes
            attachments.
          </p>
          <a href={mailto} class="tap sheet-quiet px-4 py-2 no-underline text-slate inline-block">
            Email a report
          </a>
        </div>
      </div>
    )
  }

  <div class="wrap prose-field pb-4">
    <h2>What happens to it</h2>
    <ol class="max-w-[58ch]">
      <li>It lands in a private bucket. Nothing is public at this point.</li>
      <li>I read it, and check it against whoever sets the rule where I can.</li>
      <li>
        If it holds up, it becomes a dated entry on the record with the date you
        were there, credited to you if you gave a name.
      </li>
      <li>
        Photos that get used are stripped of location data and camera
        identifiers before they go anywhere near the site.
      </li>
    </ol>
    <p class="max-w-[58ch]">
      <a href="/how-we-verify/">The full method is here</a>, including the three
      things I've already got wrong.
    </p>
  </div>
</Layout>

<script>
  /*
   * Resize before upload.
   *
   * A modern phone photo is 4-6MB and 12 megapixels. Nothing on this site
   * renders wider than 1400px, so sending the original wastes the visitor's
   * data and would push the Worker past the free plan's 10ms CPU allowance the
   * moment anything server-side touched it. 1600px on the long edge at q0.82
   * lands around 300KB and is still more detail than the site publishes.
   *
   * If any of this fails — no canvas, an image the browser won't decode, a
   * blob that comes back empty — the original file is sent unchanged. A
   * degraded upload beats a failed one.
   */
  const form = document.getElementById("report-form");
  if (form) {
    const input = document.getElementById("photos");
    const status = form.querySelector("[data-status]");
    const note = form.querySelector("[data-photo-note]");
    const MAX_EDGE = 1600;
    const MAX_PHOTOS = 4;

    const shrink = (file) =>
      new Promise((resolve) => {
        if (!/^image\/(jpeg|png|webp)$/.test(file.type)) return resolve(file);
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          URL.revokeObjectURL(url);
          const scale = Math.min(1, MAX_EDGE / Math.max(img.width, img.height));
          if (scale === 1 && file.size < 900_000) return resolve(file);
          const canvas = document.createElement("canvas");
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          const ctx = canvas.getContext("2d");
          if (!ctx) return resolve(file);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          canvas.toBlob(
            (blob) => {
              if (!blob || blob.size >= file.size) return resolve(file);
              resolve(new File([blob], file.name.replace(/\.\w+$/, "") + ".jpg", { type: "image/jpeg" }));
            },
            "image/jpeg",
            0.82,
          );
        };
        img.onerror = () => {
          URL.revokeObjectURL(url);
          resolve(file);
        };
        img.src = url;
      });

    const kb = (n) => `${Math.round(n / 1024)}KB`;

    input?.addEventListener("change", () => {
      const files = [...(input.files ?? [])];
      if (!files.length) {
        note.hidden = true;
        return;
      }
      note.hidden = false;
      note.textContent =
        files.length > MAX_PHOTOS
          ? `That's ${files.length}. Only the first ${MAX_PHOTOS} will be sent.`
          : `${files.length} photo${files.length > 1 ? "s" : ""} ready.`;
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      status.textContent = "Preparing…";

      const data = new FormData(form);
      data.delete("photos");
      data.set("js", "1");

      const files = [...(input?.files ?? [])].slice(0, MAX_PHOTOS);
      let sent = 0;
      for (const file of files) {
        const small = await shrink(file);
        sent += small.size;
        data.append("photos", small, small.name);
        status.textContent = `Preparing… ${kb(sent)}`;
      }

      status.textContent = files.length ? `Sending ${kb(sent)}…` : "Sending…";
      try {
        const res = await fetch(form.action, { method: "POST", body: data });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || body.error) {
          status.textContent = body.error || "That didn't send. Try again in a minute.";
          button.disabled = false;
          return;
        }
        form.innerHTML =
          '<p class="label m-0 text-flag-green-bearing">Sent</p>' +
          '<p class="mt-2 mb-0 text-[1rem] leading-[1.55] max-w-[54ch]">Thank you — that goes in front of a person, not onto the site. ' +
          "If it changes a fact you'll see the date on the record change.</p>";
      } catch {
        status.textContent = "That didn't send. Your connection, or mine.";
        button.disabled = false;
      }
    });
  }
</script>
