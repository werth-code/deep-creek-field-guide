---
/**
 * The audit page — every record on the site with its tier, source and age.
 *
 * This is the claim made checkable. It's generated from the same JSON the pages
 * render from, so it cannot flatter the site: if a record is thin or stale, it
 * shows up here whether or not anyone remembered to mention it.
 */
import Layout from "../layouts/Layout.astro";

import stateParksData from "../data/state-parks.json";
import regionalParksData from "../data/regional-parks.json";
import nearbyData from "../data/nearby.json";
import indoorData from "../data/indoor.json";
import type { StatePark, RegionalPark } from "../lib/parks";
import { completenessRegional, completenessState } from "../lib/parks";
import type { NearbyPlace } from "../lib/nearby";
import { completeness as completenessIndoor, type IndoorPlace } from "../lib/indoor";
import { tierOf, type Tier, type Verifiable } from "../lib/verification";
import { ageInDays, formatStampDate } from "../lib/dates";

interface Row {
  name: string;
  href: string;
  section: string;
  tier: Tier;
  source: string;
  url: string | null;
  date: string | null;
  age: number | null;
  known: number;
  total: number;
}

function row(
  item: Verifiable & { name: string },
  href: string,
  section: string,
  known: number,
  total: number,
): Row {
  const tier = tierOf(item);
  const date = tier === "confirmed" ? item.verifiedDate : (item.sourcedOn ?? null);
  return {
    name: item.name,
    href,
    section,
    tier,
    source:
      tier === "confirmed"
        ? (item.verifiedSource ?? "—")
        : (item.sources?.[0]?.label ?? "—"),
    url: tier === "confirmed" ? null : (item.sources?.[0]?.url ?? null),
    date,
    age: ageInDays(date),
    known,
    total,
  };
}

const stateParks = stateParksData as StatePark[];
const regional = regionalParksData as RegionalPark[];
const nearby = nearbyData as unknown as NearbyPlace[];
const indoor = indoorData as unknown as IndoorPlace[];

const rows: Row[] = [
  ...stateParks.map((p) => {
    const c = completenessState(p);
    return row(p, `/parks/${p.slug}/`, "State parks", c.known, c.total);
  }),
  ...regional.map((p) => {
    const c = completenessRegional(p);
    return row(p, `/parks/regional/${p.slug}/`, "Town parks", c.known, c.total);
  }),
  /* Nearby and Indoors were missing from this table while the page called
     itself "every fact on this site". A promise the audit doesn't cover is
     the exact thing this page exists to stop. */
  ...nearby.map((p) => row(p, `/nearby/${p.slug}/`, "Just over the line", 0, 0)),
  ...indoor.map((p) => {
    const c = completenessIndoor(p);
    return row(p, `/indoors/${p.slug}/`, "Indoors", c.known, c.total);
  }),
];

/* Oldest first — the point of the page is to surface what's gone stale, not to
   lead with the freshest thing we did. */
const ordered = [...rows].sort((a, b) => (b.age ?? 1e9) - (a.age ?? 1e9));

const counts = {
  confirmed: rows.filter((r) => r.tier === "confirmed").length,
  sourced: rows.filter((r) => r.tier === "sourced").length,
  reported: rows.filter((r) => r.tier === "reported").length,
};
const ages = rows.map((r) => r.age).filter((a): a is number => a !== null);
const oldest = ages.length ? Math.max(...ages) : null;

const TIER_LABEL: Record<Tier, string> = {
  confirmed: "Confirmed",
  sourced: "From source",
  reported: "Unpublished",
};
const TIER_CLASS: Record<Tier, string> = {
  confirmed: "text-flag-green-bearing",
  sourced: "text-contour-deep",
  reported: "text-flag-red-bearing",
};
---

<Layout
  title="Every fact on this site, with its source"
  description="The full audit: every record on Deep Creek Field Guide — parks, town parks, museums, libraries and the places just over the line — how each was checked, who said so and how long ago."
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Audit</p>
    <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[17ch] text-slate">
      Every page, and where it came from
    </h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      One row per page on this site, and every name is a link to it. Oldest
      check first, so whatever is going stale is at the top.
    </p>
  </div>

  <div class="wrap pb-8">
    <dl class="sheet breakout grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-lake/30">
      {
        [
          { n: String(rows.length), label: "records" },
          { n: String(counts.confirmed), label: "confirmed by phone" },
          { n: String(counts.sourced), label: "read from source" },
          { n: oldest === null ? "—" : `${oldest}d`, label: "oldest check" },
        ].map((s) => (
          <div class="px-4 py-4">
            <dt class="font-display text-[1.9rem] font-semibold text-slate leading-none tracking-[-0.04em]">
              {s.n}
            </dt>
            <dd class="m-0 mt-1.5 stamp text-ink-soft">{s.label}</dd>
          </div>
        ))
      }
    </dl>

    {
      counts.confirmed === 0 && (
        <p class="mt-4 mb-0 text-[0.92rem] leading-[1.55] text-ink-soft max-w-[58ch]">
          Nothing is phone-confirmed yet. Everything on the site is currently
          read from a named primary source — the county, Maryland DNR, or a
          town's own listing — and every page says so. The calls are in
          progress; this number will move.
        </p>
      )
    }
  </div>

  <div class="wrap pb-9">
    {/*
      Five columns will not fit a phone, and the answer is not a sideways
      scrollbar — a table you have to drag is a table nobody reads the right
      half of, and the right half here is the source and the date, which is the
      entire point of the page.

      So each row becomes a block below `sm`, with the column headings carried
      down as inline labels. Same markup, same cells, no duplicate DOM: the
      header row hides and the labels appear. Delaware's copy of this page has
      worked this way for a while; this brings the two into line.
    */}
    <div class="sheet breakout overflow-hidden">
      <table class="w-full border-collapse text-left">
        <thead class="hidden sm:table-header-group">
          <tr class="border-b-2 border-contour">
            <th scope="col" class="label px-4 py-3 font-normal">Record</th>
            <th scope="col" class="label px-4 py-3 font-normal">How</th>
            <th scope="col" class="label px-4 py-3 font-normal">Source</th>
            <th scope="col" class="label px-4 py-3 font-normal whitespace-nowrap">Checked</th>
            <th scope="col" class="label px-4 py-3 font-normal whitespace-nowrap">Fields</th>
          </tr>
        </thead>
        <tbody>
          {
            ordered.map((r) => (
              <tr class="block sm:table-row border-b border-lake/25 last:border-b-0 align-top">
                <th scope="row" class="block sm:table-cell px-4 pt-3.5 sm:py-3 text-left font-normal">
                  <a href={r.href} class="text-[0.94rem] font-medium">{r.name}</a>
                  <span class="stamp text-ink-soft block mt-0.5">{r.section}</span>
                </th>
                <td class={`block sm:table-cell px-4 pt-2 sm:py-3 stamp sm:whitespace-nowrap ${TIER_CLASS[r.tier]}`}>
                  {TIER_LABEL[r.tier]}
                </td>
                <td class="block sm:table-cell px-4 pt-2 sm:py-3 text-[0.86rem] leading-snug sm:max-w-[16rem]">
                  <span class="label sm:hidden block mb-0.5">Source</span>
                  {r.url ? <a href={r.url} rel="nofollow">{r.source}</a> : r.source}
                </td>
                <td class="block sm:table-cell px-4 pt-2 sm:py-3 stamp text-ink-soft sm:whitespace-nowrap">
                  <span class="label sm:hidden me-2">Checked</span>
                  {r.date ? formatStampDate(r.date) : "—"}
                  {r.age !== null && <span class="sm:block sm:mt-0.5 ms-1 sm:ms-0">({r.age}d ago)</span>}
                </td>
                <td class="block sm:table-cell px-4 pt-2 pb-3.5 sm:py-3 stamp text-ink-soft sm:whitespace-nowrap">
                  <span class="label sm:hidden me-2">Fields confirmed</span>
                  {r.total === 0 ? "—" : `${r.known}/${r.total}`}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="wrap prose-field pb-4">
    <h2>Reading this table</h2>
    <p class="max-w-[58ch]">
      <strong>Confirmed</strong> means someone called or visited and the source
      column names who answered. <strong>From source</strong> means it was read
      from a named primary source — linked, so you can check it yourself — but
      not yet confirmed by phone. Anything that would be
      <strong>unpublished</strong> never reaches this table at all: it's blocked
      from search and dropped from the sitemap by the build.
    </p>
    <p class="max-w-[58ch]">
      <strong>Fields</strong> is how much of a record I actually know. A park
      showing 3/11 is a real park with a real gap, not a mistake — the page will
      say "not confirmed" on the eight I haven't checked instead of guess.
    </p>
    <p class="max-w-[58ch]">
      <a href="/how-we-verify/">The full method is here</a>, including what
      happens when two sources disagree.
    </p>
  </div>
</Layout>
