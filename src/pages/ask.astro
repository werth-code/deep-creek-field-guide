---
/**
 * Ask — the park finder.
 *
 * The matcher, the index and the deterministic lead are all bundled into the
 * page, so this works with JavaScript's only dependency being the browser.
 * The worker is optional: if PUBLIC_CHAT_ENDPOINT is unset or the call fails,
 * the page still answers correctly, just without the conversational framing.
 *
 * Facts are rendered from the index, never from the model. See
 * src/lib/chat/index.ts for why that is not negotiable.
 */
import Layout from "../layouts/Layout.astro";
import FlagIcon from "../components/FlagIcon.astro";
import { CHAT_INDEX } from "../lib/chat/index";

const endpoint = import.meta.env.PUBLIC_CHAT_ENDPOINT ?? "";

const examples = [
  "Swimming and a playground",
  "Somewhere with restrooms",
  "Waterfall hike",
  "Can I go today without booking?",
  "Boat launch for a kayak",
  "Sledding in winter",
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Deep Creek Field Guide — park finder",
    applicationCategory: "TravelApplication",
    operatingSystem: "Any",
    url: "https://deepcreekfieldguide.com/ask/",
    description:
      "Ask for what you need — restrooms, a beach, a walk-in visit — and get the Garrett County parks that confirm it, with the source and date for every fact.",
  },
];
---

<Layout
  title="Ask — find a Garrett County park by what you need"
  description="Say what you're after — restrooms, swimming, a waterfall, somewhere you can turn up to without booking — and get the Garrett County parks that confirm it."
  schema={schema}
>
  <div class="wrap pt-11 pb-6">
    <p class="label m-0">Park finder</p>
    <h1 class="text-[2.2rem] sm:text-[2.9rem] mt-3.5 mb-0 max-w-[15ch] text-slate">
      Ask for what you need
    </h1>
    <p class="mt-5 mb-0 text-[1.15rem] leading-[1.5] max-w-[54ch]">
      Tell it what matters for the trip. It answers from the same checked data
      as the rest of the site — and tells you plainly when something hasn't been
      checked, instead of guessing.
    </p>
  </div>

  <div class="wrap pb-6">
    <form id="ask-form" class="sheet breakout p-4 sm:p-5" autocomplete="off">
      <label for="ask-input" class="label block">Your question</label>
      <div class="mt-2.5 flex flex-col sm:flex-row gap-2.5">
        <input
          id="ask-input"
          name="q"
          type="text"
          required
          maxlength="200"
          placeholder="Somewhere to swim with a playground"
          class="flex-1 min-w-0 bg-paper border-2 border-slate px-3 py-2.5 text-[1rem] text-ink placeholder:text-ink-soft focus:outline-none focus:ring-2 focus:ring-contour"
        />
        <button
          type="submit"
          class="tap bg-slate text-snow border-2 border-slate px-5 py-2.5 font-mono text-[0.78rem] uppercase tracking-[0.1em] font-medium hover:bg-ink"
        >
          Ask
        </button>
      </div>

      <p class="label mt-4 mb-0">Or try</p>
      <ul class="list-none p-0 m-0 mt-2 flex flex-wrap gap-1.5">
        {
          examples.map((e) => (
            <li>
              <button
                type="button"
                data-example={e}
                class="tap sheet-quiet px-2.5 py-1 stamp text-slate hover:bg-slate hover:text-snow border-0"
              >
                {e}
              </button>
            </li>
          ))
        }
      </ul>
    </form>
  </div>

  <div class="wrap pb-4">
    <div id="ask-out" aria-live="polite"></div>
  </div>

  <div class="wrap prose-field pb-4">
    <h2>How this answers</h2>
    <p class="max-w-[58ch]">
      Your question is turned into a checklist — restrooms, a beach, no booking
      — and matched against the data by plain comparison. A park only appears as
      a match when the thing you asked for is <em>confirmed</em> for it.
    </p>
    <p class="max-w-[58ch]">
      Anything unchecked is shown separately and labeled, because a blank in
      my data means nobody has asked yet, not that the park lacks it. Treating
      those as "no" would be inventing facts at scale.
    </p>
    <p class="max-w-[58ch]">
      There's an AI here, and it's kept on a short lead: it writes the summary
      line and orders the results. It's never given the park data and can't
      state a fact about a park. Everything you see below the summary is
      rendered from the checked dataset, with the same source link the park page
      carries. <a href="/how-we-verify/">The full method is here</a>.
    </p>
  </div>
</Layout>

<script define:vars={{ INDEX: CHAT_INDEX, ENDPOINT: endpoint }}>
  // The matcher is duplicated here in plain JS rather than imported, because
  // this script is the client bundle and the TS module is build-time only.
  // Keep in step with src/lib/chat/match.ts.
  const VOCAB = [
    [["restroom","restrooms","toilet","toilets","bathroom","bathrooms","washroom","wc","porta potty"],"restrooms"],
    [["playground","play ground","swings","swing set","slide","play area"],"playground"],
    [["splash pad","splashpad","splash park","spray park","sprayground","water play","spray ground"],"splashPad"],
    [["swim","swimming","swimmable","wade","wading"],"swimming"],
    [["beach","sand","sandy"],"beach"],
    [["trail","trails","hike","hiking","walk","walking","hikes"],"trails"],
    [["camp","camping","campground","campsite","campsites","tent","tents","rv"],"camping"],
    [["cabin","cabins","lodge","lodging"],"cabins"],
    [["boat rental","boat rentals","rent a boat","rent boats","rent a kayak","rent kayaks","hire a boat","rentals"],"boatRentals"],
    [["boat launch","boat ramp","launch","ramp","kayak","canoe","paddle","paddling","boating","boat"],"boatLaunch"],
    [["fish","fishing","trout","angling"],"fishing"],
    [["picnic","picnic table","picnic tables","lunch","eat outside"],"picnic"],
    [["pavilion","pavilions","shelter","shelters","gazebo","covered"],"pavilion"],
    [["sports","ball field","ball fields","baseball","soccer","basketball","tennis","court","courts","field","fields"],"sports"],
    [["paved","paved path","stroller","strollers","wheelchair","accessible","pram","buggy"],"pavedPath"],
    [["winter","snow","sled","sledding","ski","skiing","snowshoe","cross country","cross-country"],"winterUse"],
    [["waterfall","waterfalls","falls","cascade"],"waterfall"],
    [["dog","dogs","pet","pets","puppy","leash","leashed"],"petsAllowed"],
    [["no reservation","without a reservation","without booking","walk in","walk-in","turn up","show up","last minute","spontaneous","no booking","same day","today","right now","drive up"],"walkIn"],
    [["free","no fee","no charge","costs nothing","without paying","cheap"],"free"],
  ];
  const PHRASES = VOCAB.flatMap(([ws,k]) => ws.map(w => [w,k])).sort((a,b) => b[0].length - a[0].length);
  const KIND_WORDS = [
    [["state park","state parks","state forest","dnr","big park","big parks"],"state"],
    [["town park","town parks","local park","local parks","municipal","community park","community parks"],"town"],
    [["museum","museums","library","libraries","nature center","nature centre","indoors","inside","rainy day","rainy","when it rains","out of the rain"],"indoor"],
    [["nearby","near by","over the line","out of county","outside the county","west virginia","wv","allegany","further afield","day trip"],"nearby"],
  ];
  const SAYS = {
    restrooms:"restrooms", playground:"a playground", splashPad:"a splash pad", indoors:"somewhere indoors", giftShop:"a gift shop", swimming:"swimming", beach:"a beach",
    trails:"trails", camping:"camping", cabins:"cabins", boatLaunch:"a boat launch", boatRentals:"boat rentals",
    fishing:"fishing", picnic:"picnic tables", pavilion:"a pavilion", sports:"courts or fields",
    pavedPath:"a paved path", winterUse:"winter use", waterfall:"a waterfall",
    petsAllowed:"dogs allowed", walkIn:"no reservation needed", free:"no fee",
  };
  const NEGATORS = ["no ","without ","not ","don't ","dont ","doesn't ","avoid ","except "];

  const TOWNS = [...new Set(INDEX.map(e => e.town.toLowerCase()))].sort((a,b)=>b.length-a.length);
  function aliases(name) {
    const full = name.toLowerCase();
    const out = new Set([full]);
    const cut = full.split(/ at | of /)[0].trim();
    const trimmed = cut.replace(/\s+(state park|state forest|memorial park|community park|town park|park)$/,"").trim();
    for (const a of [cut, trimmed]) if (a.length >= 6) out.add(a);
    return [...out];
  }
  const ALIAS_USES = new Map();
  for (const e of INDEX) for (const a of aliases(e.name)) ALIAS_USES.set(a,(ALIAS_USES.get(a)??0)+1);
  const NAMES = INDEX.flatMap(e => aliases(e.name).filter(a => ALIAS_USES.get(a)===1).map(a => [a, e.slug]))
    .sort((a,b)=>b[0].length-a[0].length);

  const norm = s => s.toLowerCase().replace(/[^a-z0-9\s'-]/g," ").replace(/\s+/g," ").trim();
  function has(hay, needle) {
    const i = hay.indexOf(needle);
    if (i === -1) return false;
    const b = i === 0 ? " " : hay[i-1];
    const a = i + needle.length >= hay.length ? " " : hay[i+needle.length];
    return !/[a-z0-9]/.test(b) && !/[a-z0-9]/.test(a);
  }

  function parse(raw) {
    const q = norm(raw), wants = [], excludes = [];
    let rest = ` ${q} `;
    for (const [phrase, key] of PHRASES) {
      if (!has(rest, phrase)) continue;
      const at = rest.indexOf(phrase);
      const lead = rest.slice(Math.max(0, at-12), at);
      const neg = NEGATORS.some(n => lead.endsWith(n));
      const bucket = neg && key !== "walkIn" && key !== "free" ? excludes : wants;
      if (!bucket.includes(key)) bucket.push(key);
      rest = rest.replace(phrase, " ");
    }
    let kind = null;
    for (const [ws,k] of KIND_WORDS) if (ws.some(w => has(` ${q} `, w))) { kind = k; break; }
    const town = TOWNS.find(t => has(` ${q} `, t)) ?? null;
    const q1 = ` ${q} `;
    let named = (NAMES.find(([n]) => has(q1, n)) ?? [])[1] ?? null;
    if (!named && q.length >= 6) {
      const bare = t => t.toLowerCase().replace(/'/g,"");
      const starts = INDEX.filter(e => bare(e.name).startsWith(bare(q)));
      if (starts.length === 1) named = starts[0].slug;
    }
    return { raw, wants, excludes, kind, town, named };
  }

  function match(raw) {
    const query = parse(raw);
    const scored = [];
    for (const entry of INDEX) {
      if (query.kind && entry.kind !== query.kind) continue;
      if (query.town && entry.town.toLowerCase() !== query.town) continue;
      if (query.excludes.some(k => entry.attrs[k] === true)) continue;
      const met = query.wants.filter(k => entry.attrs[k] === true);
      const unknown = query.wants.filter(k => entry.attrs[k] === null || entry.attrs[k] === undefined);
      if (query.wants.some(k => entry.attrs[k] === false)) continue;
      let score = met.length * 10 + (query.named === entry.slug ? 100 : 0);
      for (const w of norm(raw).split(" ")) if (w.length > 3 && entry.haystack.includes(w)) score += 1;
      if (entry.tier === "confirmed") score += 2;
      score += entry.facts.filter(f => f.state !== "unknown").length * 0.1;
      scored.push({ entry, met, unknown, score });
    }
    scored.sort((a,b) => b.score - a.score || a.entry.name.localeCompare(b.entry.name));
    const empty = !query.wants.length && !query.excludes.length && !query.kind && !query.town && !query.named;
    /* A named record leads, whatever bucket it fell in — see match.ts. */
    const lead = query.named ? scored.find(s => s.entry.slug === query.named) ?? null : null;
    const rest = lead ? scored.filter(s => s !== lead) : scored;
    return {
      query,
      matches: [...(lead ? [lead] : []), ...rest.filter(s => !s.unknown.length)],
      unconfirmed: rest.filter(s => s.unknown.length),
      empty,
    };
  }

  const listOf = a => a.length === 0 ? "" : a.length === 1 ? a[0] : a.slice(0,-1).join(", ") + " and " + a[a.length-1];
  const pl = (n,o,m) => n === 1 ? o : m;
  const says = k => SAYS[k] ?? k;
  const cap = s => s.replace(/\b[a-z]/g, c => c.toUpperCase());

  function deterministicLead(r) {
    const asked = listOf(r.query.wants.map(says));
    const where = r.query.town ? ` in ${cap(r.query.town)}` : "";
    const what = ({state:"state park",town:"town park",indoor:"museum or library",nearby:"place over the line"})[r.query.kind] || "place";
    if (r.empty) return "Tell me what you're after — a beach, restrooms, a playground, trails, somewhere you can turn up to without booking — and I'll show you what's confirmed.";
    if (!r.matches.length && !r.unconfirmed.length)
      return `Nothing on the site matches${asked ? " " + asked : ""}${where}. That may mean it doesn't exist here, or that I haven't checked it yet.`;
    // Gaps are a UNION across candidates — never phrase them as though every
    // candidate is missing every item.
    const gapsOf = rows => listOf([...new Set(rows.flatMap(s => s.unknown))].map(says));
    if (!r.matches.length)
      return `Nothing is confirmed for ${asked || "that"}${where} yet, but ${r.unconfirmed.length} ${pl(r.unconfirmed.length, what, what+"s")} could still qualify — the unchecked gaps among them are ${gapsOf(r.unconfirmed)}. They're below so you can call and ask.`;
    const head = `${r.matches.length} ${pl(r.matches.length, what, what+"s")}${where} ${pl(r.matches.length,"confirms","confirm")} ${asked || "what you asked for"}.`;
    if (!r.unconfirmed.length) return head;
    return `${head} Another ${r.unconfirmed.length} could qualify — the gaps among them are ${gapsOf(r.unconfirmed)}, which nobody has checked yet.`;
  }

  function leadIsSafe(lead, r) {
    if (!lead || lead.length > 400) return false;
    const ok = new Set([r.matches.length, r.unconfirmed.length, r.matches.length + r.unconfirmed.length, r.query.wants.length].map(String));
    for (const n of lead.match(/\d+/g) ?? []) if (!ok.has(n)) return false;
    const offered = [...r.matches, ...r.unconfirmed].map(s => s.entry.name.toLowerCase());
    const known = new Set([...offered, ...offered.flatMap(n => n.split(/\s+/))]);
    for (const m of lead.match(/\b[A-Z][a-z]+(?:\s+[A-Z][a-z]+)+/g) ?? []) {
      const low = m.toLowerCase();
      if (offered.some(n => n.includes(low) || low.includes(n))) continue;
      if (low.split(/\s+/).every(w => known.has(w))) continue;
      return false;
    }
    return true;
  }

  const esc = s => String(s).replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));

  function card(s, showUnknown) {
    const e = s.entry;
    const chips = e.facts.filter(f => f.state === "yes").slice(0, 6)
      .map(f => `<li class="sheet-quiet px-2 py-0.5 stamp text-[0.68rem] text-slate">${esc(f.label)}</li>`).join("");
    const gaps = showUnknown && s.unknown.length
      ? `<p class="mt-2.5 mb-0 text-[0.85rem] leading-snug text-ink-soft">Not checked here: ${esc(s.unknown.map(says).join(", "))}.</p>`
      : "";
    const res = e.reservation
      ? `<p class="stamp mt-2.5 mb-0 ${e.reservation.startsWith("Reservation required") ? "text-flag-red-bearing" : "text-ink-soft"}">${esc(e.reservation)}</p>`
      : "";
    const src = e.source
      ? `<p class="mt-3 mb-0 text-[0.8rem] leading-snug text-ink-soft">${e.tier === "confirmed" ? "Confirmed" : "Read from"} <a href="${esc(e.source.url)}" rel="nofollow">${esc(e.source.label)}</a></p>`
      : "";
    /* A yes can be true everywhere and wrong where you're standing. Herrington
       Manor allows dogs AND has a beach, and bans them from the sand — both
       attributes match honestly and the pair is misleading. The warning that
       resolves it has to travel with the result, not sit on the page the
       reader hasn't opened yet. */
    const warn = e.warnings && e.warnings.length
      ? `<p class="mt-2.5 mb-0 text-[0.84rem] leading-snug text-flag-red-bearing">${esc(e.warnings[0])}</p>`
      : "";
    return `<article class="sheet p-4">
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="font-display text-[1.1rem] font-semibold tracking-[-0.03em] m-0 text-slate">
          <a href="${esc(e.url)}">${esc(e.name)}</a>
        </h3>
        <span class="stamp text-ink-soft shrink-0">${esc(e.town)}</span>
      </div>
      <p class="stamp text-ink-soft mt-1 mb-0">${esc(e.kindLabel)}</p>
      ${res}
      ${warn}
      ${chips ? `<ul class="list-none p-0 m-0 mt-3 flex flex-wrap gap-1.5">${chips}</ul>` : ""}
      ${gaps}
      ${src}
    </article>`;
  }

  /* ------------------------------------------------------- conversation -- */

  const form = document.getElementById("ask-form");
  const input = document.getElementById("ask-input");
  const out = document.getElementById("ask-out");

  /**
   * Conversation state.
   *
   * `filters` accumulates across turns — "somewhere to swim", then "with
   * restrooms", narrows rather than restarting. `messages` is the transcript
   * sent to the worker: the visitor's own words and my own summary lines, and
   * never any park data, so the model cannot launder a fact through history it
   * wrote earlier.
   */
  const EMPTY_FILTERS = { wants: [], excludes: [], town: null, kind: null };
  let filters = { ...EMPTY_FILTERS };
  let messages = [];
  let turns = [];
  let busy = false;
  let seq = 0;

  const VOCAB_KEYS = new Set(Object.keys(SAYS));
  const TOWN_LIST = [...new Set(INDEX.map(e => e.town))];
  const KIND_LIST = ["state", "town", "indoor", "nearby"];

  const validFilters = f => ({
    wants: [...new Set((f?.wants ?? []).filter(k => VOCAB_KEYS.has(k)))],
    excludes: [...new Set((f?.excludes ?? []).filter(k => VOCAB_KEYS.has(k)))],
    town: TOWN_LIST.includes(f?.town) ? f.town : null,
    kind: KIND_LIST.includes(f?.kind) ? f.kind : null,
  });

  /** Merge a fresh deterministic parse into what we already knew. */
  function accumulate(prev, parsed) {
    return validFilters({
      wants: [...prev.wants, ...parsed.wants],
      excludes: [...prev.excludes, ...parsed.excludes],
      town: parsed.town ?? prev.town,
      kind: parsed.kind ?? prev.kind,
    });
  }

  /** Run the matcher directly off a filter set, bypassing text parsing. */
  function runFilters(f) {
    const scored = [];
    for (const entry of INDEX) {
      if (f.kind && entry.kind !== f.kind) continue;
      if (f.town && entry.town !== f.town) continue;
      if (f.excludes.some(k => entry.attrs[k] === true)) continue;
      if (f.wants.some(k => entry.attrs[k] === false)) continue;
      const met = f.wants.filter(k => entry.attrs[k] === true);
      const unknown = f.wants.filter(k => entry.attrs[k] === null || entry.attrs[k] === undefined);
      let score = met.length * 10;
      if (entry.tier === "confirmed") score += 2;
      score += entry.facts.filter(x => x.state !== "unknown").length * 0.1;
      scored.push({ entry, met, unknown, score });
    }
    scored.sort((a, b) => b.score - a.score || a.entry.name.localeCompare(b.entry.name));
    const empty = !f.wants.length && !f.excludes.length && !f.town && !f.kind;
    return {
      query: { wants: f.wants, excludes: f.excludes, town: f.town, kind: f.kind },
      matches: scored.filter(s => !s.unknown.length),
      unconfirmed: scored.filter(s => s.unknown.length),
      empty,
    };
  }

  function chipRow() {
    const bits = [
      ...filters.wants.map(k => ({ t: says(k), kind: "wants", v: k })),
      ...filters.excludes.map(k => ({ t: `not ${says(k)}`, kind: "excludes", v: k })),
      ...(filters.town ? [{ t: filters.town, kind: "town", v: filters.town }] : []),
      ...(filters.kind ? [{ t: { state: "State parks", town: "Town parks", indoor: "Museums & libraries", nearby: "Just over the line" }[filters.kind], kind: "kind", v: filters.kind }] : []),
    ];
    if (!bits.length) return "";
    return `<div class="flex flex-wrap items-center gap-1.5 mb-4">
      <span class="label">Looking for</span>
      ${bits.map(b => `<button type="button" data-drop="${esc(b.kind)}" data-val="${esc(b.v)}"
          class="tap sheet-quiet px-2.5 py-1 stamp text-slate hover:bg-flag-red-bearing hover:text-white border-0"
          title="Remove">${esc(b.t)} <span aria-hidden="true">×</span><span class="sr-only"> — remove</span></button>`).join("")}
      <button type="button" data-drop="all" class="tap stamp text-ink-soft underline px-1">clear all</button>
    </div>`;
  }

  function bubble(role, text) {
    return role === "user"
      ? `<p class="m-0 mt-5 first:mt-0"><span class="inline-block bg-slate text-snow px-3 py-1.5 text-[0.95rem] leading-snug max-w-[46ch]">${esc(text)}</span></p>`
      : `<p class="mt-2.5 mb-0 text-[1.05rem] leading-[1.5] max-w-[58ch]">${esc(text)}</p>`;
  }

  function render({ result, lead, clarify, followUps, pending }) {
    const grid = a => a.length ? `<div class="grid gap-3 sm:grid-cols-2 mt-4">${a.map(s => card(s, true)).join("")}</div>` : "";
    const bare = result.empty;

    const answer = `
      ${bubble("assistant", lead)}
      ${pending ? '<p class="stamp text-ink-soft mt-1.5 mb-0">thinking…</p>' : ""}
      ${clarify ? `<div class="sheet-quiet px-4 py-3.5 mt-4">
          <p class="m-0 text-[0.98rem] leading-snug font-medium text-slate">${esc(clarify.question)}</p>
          ${clarify.options.length ? `<ul class="list-none p-0 m-0 mt-2.5 flex flex-wrap gap-1.5">${
            clarify.options.map(o => `<button type="button" data-example="${esc(o)}" data-replace="1" class="tap sheet px-2.5 py-1 stamp text-slate hover:bg-slate hover:text-snow border-0">${esc(o)}</button>`).join("")
          }</ul>` : ""}
        </div>` : ""}
      ${bare ? "" : result.matches.length ? `<p class="label mt-6 mb-0 text-flag-green-bearing">Confirmed</p>${grid(result.matches)}` : ""}
      ${!bare && result.unconfirmed.length ? `<p class="label mt-6 mb-0 text-contour-deep">Might match — not checked</p>
         <p class="mt-1.5 mb-0 text-[0.88rem] leading-snug text-ink-soft max-w-[58ch]">A blank in my data means nobody has asked yet, not that the park lacks it.</p>
         ${grid(result.unconfirmed)}` : ""}
      ${!clarify && followUps.length ? `<div class="mt-6"><p class="label m-0">Ask next</p>
         <ul class="list-none p-0 m-0 mt-2 flex flex-wrap gap-1.5">${
           followUps.map(f => `<button type="button" data-example="${esc(f)}" class="tap sheet-quiet px-2.5 py-1 stamp text-slate hover:bg-slate hover:text-snow border-0">${esc(f)}</button>`).join("")
         }</ul></div>` : ""}`;

    turns[turns.length - 1].html = answer;

    out.innerHTML = `<section class="sheet breakout p-4 sm:p-5">
      ${chipRow()}
      ${turns.map(t => `${bubble("user", t.q)}${t.html}`).join('<hr class="border-0 border-t-2 border-lake/25 mt-7" />')}
    </section>`;
    out.querySelector("section > p:last-of-type, section")?.scrollIntoView?.({ behavior: "smooth", block: "nearest" });
  }

  async function ask(q, { replace = false } = {}) {
    if (busy) return;
    const mine = ++seq;

    const parsed = parse(q);
    const isReset = /^(start over|reset|new search|clear)$/i.test(q.trim());
    /* Answering "which matters most?" means narrow to THAT, not add it to the
       pile we already failed to satisfy. Accumulating here would leave the
       question pointless — the result set could not change. */
    const base = isReset ? { ...EMPTY_FILTERS }
      : replace ? { ...filters, wants: [], excludes: [] }
      : filters;
    filters = isReset ? base : accumulate(base, parsed);

    let result = runFilters(filters);
    // A question that parsed to nothing at all, with nothing remembered.
    if (result.empty) result = match(q);

    turns.push({ q, html: "" });
    messages.push({ role: "user", content: q.slice(0, 400) });

    const detLead = deterministicLead(result);
    render({ result, lead: detLead, clarify: null, followUps: [], pending: Boolean(ENDPOINT) });
    if (!ENDPOINT) { messages.push({ role: "assistant", content: detLead }); return; }

    busy = true;
    let data;
    try {
      const res = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          site: "deep-creek",
          messages: messages.slice(-12),
          vocabulary: Object.entries(SAYS).map(([key, saysText]) => ({ key, says: saysText })),
          towns: TOWN_LIST,
          kinds: KIND_LIST,
          filters,
          candidates: [...result.matches, ...result.unconfirmed].slice(0, 24).map(s => ({
            slug: s.entry.slug, name: s.entry.name, kind: s.entry.kindLabel, town: s.entry.town,
            met: s.met, unknown: s.unknown, confirmed: s.entry.tier === "confirmed",
          })),
        }),
      });
      if (!res.ok) throw new Error("bad status");
      data = await res.json();
    } catch {
      busy = false;
      if (mine === seq) {
        render({ result, lead: detLead, clarify: null, followUps: [], pending: false });
        messages.push({ role: "assistant", content: detLead });
      }
      return;
    }
    busy = false;
    if (mine !== seq) return;   // a newer question overtook this one

    // The model's filters only ever re-run the same deterministic matcher.
    const proposed = validFilters(data?.filters);
    const changed = JSON.stringify(proposed) !== JSON.stringify(filters);
    if (changed && (proposed.wants.length || proposed.excludes.length || proposed.town || proposed.kind)) {
      filters = proposed;
      result = runFilters(filters);
    }

    const lead = leadIsSafe(data?.lead, result) ? data.lead : deterministicLead(result);

    const all = [...result.matches, ...result.unconfirmed];
    const bySlug = new Map(all.map(s => [s.entry.slug, s]));
    const order = (Array.isArray(data?.order) ? data.order : []).filter(s => bySlug.has(s));
    if (order.length) {
      const rank = new Map(order.map((s, i) => [s, i]));
      const by = (a, b) => (rank.get(a.entry.slug) ?? 999) - (rank.get(b.entry.slug) ?? 999);
      result.matches = [...result.matches].sort(by);
      result.unconfirmed = [...result.unconfirmed].sort(by);
    }

    const usable = f => { const p = parse(f); return p.wants.length || p.excludes.length || p.kind || p.town; };
    const clarify = data?.clarify?.question
      ? { question: String(data.clarify.question), options: (data.clarify.options ?? []).filter(usable).slice(0, 4) }
      : null;
    const followUps = (Array.isArray(data?.followUps) ? data.followUps : [])
      .filter(f => typeof f === "string" && f.length > 2 && f.length < 80).filter(usable).slice(0, 3);

    render({ result, lead, clarify, followUps, pending: false });
    messages.push({ role: "assistant", content: lead });
  }

  form.addEventListener("submit", e => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) return;
    input.value = "";
    ask(q);
  });

  document.addEventListener("click", e => {
    const drop = e.target.closest("[data-drop]");
    if (drop) {
      const { drop: kind, val } = drop.dataset;
      if (kind === "all") { filters = { ...EMPTY_FILTERS }; messages = []; turns = []; out.innerHTML = ""; return; }
      if (kind === "wants" || kind === "excludes") filters[kind] = filters[kind].filter(k => k !== val);
      else filters[kind] = null;
      const result = runFilters(filters);
      if (!turns.length) turns.push({ q: "(filters)", html: "" });
      render({ result, lead: deterministicLead(result), clarify: null, followUps: [], pending: false });
      return;
    }
    const b = e.target.closest("[data-example]");
    if (!b) return;
    ask(b.dataset.example, { replace: b.dataset.replace === "1" });
  });
</script>
