---
/**
 * Home.
 *
 * Orients someone who has never been, then points at the one live section.
 * Counts derive from the data so they can't drift.
 */
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import FlagIcon from "../components/FlagIcon.astro";
import StateMap from "../components/StateMap.astro";

import stateParksData from "../data/state-parks.json";
import regionalParksData from "../data/regional-parks.json";
import type { StatePark, RegionalPark } from "../lib/parks";
import indoorData from "../data/indoor.json";
import { colorFor } from "../lib/feature-colors";

const stateParks = stateParksData as StatePark[];
const regional = regionalParksData as RegionalPark[];
const reservationParks = stateParks.filter((p) => p.reservation.required === true);

const facts = [
  { n: String(stateParks.length), label: "state parks & forests" },
  { n: String(regional.length), label: "town parks" },
  { n: "3,360", label: "feet at the highest point" },
  { n: "8", label: "towns with their own parks" },
];

/* Everything with coordinates, on one map. Kinds are the section a record
   belongs to, so the filter chips read the way the nav does. */
type Geo = {
  slug: string; name: string; town?: string; kind?: string; operator?: string;
  blurb?: string; photos?: { file: string; focus?: string | null }[];
  coords?: { lat: number; lon: number; precision: "site" | "town" };
};
/* One line each, trimmed at a sentence so the card stays a card. */
const oneLine = (t: string | undefined) => {
  if (!t) return "";
  const stop = t.indexOf(". ");
  const line = stop > 40 ? t.slice(0, stop + 1) : t;
  return line.length > 160 ? line.slice(0, 157).trimEnd() + "…" : line;
};
const pin = (rows: unknown[], kind: string, href: (r: any) => string) =>
  (rows as Geo[])
    .filter((r) => r.coords)
    .map((r) => ({
      slug: r.slug, name: r.name, href: href(r), kind,
      lat: r.coords!.lat, lon: r.coords!.lon, precision: r.coords!.precision,
      blurb: oneLine(r.blurb),
      where: [r.town, r.operator].filter(Boolean).join(" · "),
      photo: r.photos?.[0]?.file ?? null,
      focus: r.photos?.[0]?.focus ?? null,
    }));

const mapPoints = [
  ...pin(stateParks as unknown[], "trails", (r) => `/parks/${r.slug}/`),
  ...pin(regional as unknown[], "playground", (r) => `/parks/regional/${r.slug}/`),
  ...pin(indoorData as unknown[], "free", (r) => `/indoors/${r.slug}/`),
];

const mapKinds = [
  { key: "trails", label: "State parks", color: colorFor("trails") },
  { key: "playground", label: "Town parks", color: colorFor("playground") },
  { key: "free", label: "Museums & libraries", color: colorFor("free") },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Deep Creek Field Guide",
    url: "https://deepcreekfieldguide.com/",
    description:
      "A reference for Garrett County and Deep Creek Lake. Every fact carries the date it was checked and the source it came from.",
    publisher: { "@type": "Organization", name: "Deep Creek Field Guide" },
  },
];
---

<Layout
  share={false}
  title="Deep Creek Lake parks, checked and dated"
  description="Deep Creek Lake and Garrett County parks: what each costs, whether there is a restroom, and which need a reservation now. Every fact carries a date."
  schema={schema}
>
  {/*
    A FRONT DOOR, NOT AN ESSAY.
    This opened with three paragraphs about Garrett County and who I am before
    it offered anywhere to go. That is a piece of writing, and it was the first
    thing between a visitor and the answer they came for. The argument for the
    site now lives on /about/ and /how-we-verify/, where someone who wants it
    will look for it. What's left here is the shortest true description and the
    two ways in.
  */}
  <div class="wrap pt-12 sm:pt-14 pb-8">
    <p class="label m-0 flex items-center gap-2">
      <Logo animate compact class="w-[0.95rem] h-[0.95rem] shrink-0" />
      A reference for Garrett County, Maryland
    </p>

    <h1 class="text-[2.4rem] sm:text-[3.3rem] mt-4 mb-0 max-w-[15ch] text-slate">
      Deep Creek Lake, checked and dated
    </h1>

    <p class="mt-5 mb-0 text-[1.2rem] leading-[1.5] max-w-[52ch]">
      What a park costs, whether there's a restroom, and which one you can't
      just turn up to any more. Every fact carries the date I checked it and
      where it came from.
    </p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href="/ask/"
        class="tap no-underline bg-slate text-snow border-2 border-slate px-5 py-3 font-mono text-[0.78rem] uppercase tracking-[0.1em] font-medium hover:bg-ink"
      >
        Find the right park →
      </a>
      <a
        href="/parks/"
        class="tap no-underline sheet-quiet border-2 border-slate text-slate px-5 py-3 font-mono text-[0.78rem] uppercase tracking-[0.1em] font-medium"
      >
        Browse all {stateParks.length + regional.length}
      </a>
    </div>
  </div>

  {
    reservationParks.length > 0 && (
      <div class="wrap pb-9">
        <aside class="sheet breakout border-l-[9px] border-l-flag-red px-4 sm:px-5 py-5">
          <p class="label text-flag-red-bearing m-0 flex items-center gap-1.5">
            <FlagIcon icon="alert" class="w-[1em] h-[1em]" />
            New for 2026
          </p>
          <p class="font-display text-[1.35rem] font-semibold tracking-[-0.03em] mt-2.5 mb-0 text-slate max-w-[26ch]">
            <a href={`/parks/${reservationParks[0].slug}/`}>Swallow Falls</a> needs a
            weekend day-use reservation
          </p>
          <p class="mt-2.5 mb-0 text-[0.98rem] leading-[1.55] max-w-[58ch]">
            Weekends and holidays, Memorial Day weekend through Labor Day, in one
            of three timed entry slots. Booking opens seven days ahead and they
            sell out. Weekdays you can still turn up and pay at the gate. Pets
            are barred from the day-use area and the Canyon Trail all summer.
          </p>
        </aside>
      </div>
    )
  }

  <div class="wrap pb-9">
    <dl class="sheet breakout grid grid-cols-2 sm:grid-cols-4 gap-0 divide-x divide-y sm:divide-y-0 divide-lake/30">
      {
        facts.map((f) => (
          <div class="px-4 py-4">
            <dt class="font-display text-[1.9rem] font-semibold text-slate leading-none tracking-[-0.04em]">
              {f.n}
            </dt>
            <dd class="m-0 mt-1.5 stamp text-ink-soft">{f.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="wrap pb-9">
    <StateMap points={mapPoints} kinds={mapKinds} />
  </div>

  <div class="wrap pb-9 grid gap-5 sm:grid-cols-2">
    {
      [
        {
          href: "/parks/",
          n: "01",
          title: "State parks",
          lede: "All ten, and the one that now needs booking.",
          detail:
            "Swallow Falls, Deep Creek Lake, Herrington Manor, New Germany and the rest. Facilities, fees, reservation status, and what I still haven't checked.",
          count: `${stateParks.length} parks and forests`,
        },
        {
          href: "/parks/regional/",
          n: "02",
          title: "Town parks",
          lede: "The small ones the towns run. Toilets first.",
          detail:
            "The county itself owns only four park sites. The ones people actually use belong to eight small towns, and nobody has put them in one place.",
          count: `${regional.length} listed`,
        },
      ].map((s) => (
        <a href={s.href} data-reveal class="sheet sheet-action no-underline block p-5 group relative">
          <span class="stamp text-contour-deep absolute top-5 right-5">{s.n}</span>
          <p class="label m-0">Section {s.n}</p>
          <p class="font-display text-[1.7rem] font-semibold mt-2 mb-0 tracking-[-0.04em] text-slate underline decoration-contour decoration-[3px] underline-offset-[0.14em] group-hover:decoration-slate">
            {s.title}
          </p>
          <p class="mt-2.5 mb-0 text-[0.98rem] leading-[1.45] font-medium">{s.lede}</p>
          <p class="mt-2 mb-0 text-[0.9rem] leading-[1.5] text-ink-soft">{s.detail}</p>
          <p class="stamp text-ink-soft mt-4 mb-0">{s.count}</p>
        </a>
      ))
    }
  </div>

  {/* The corrections and the gap list used to be retold here in full. They
      already live on the method page, told better, and repeating them made the
      front page longer than the thing it was pointing at. */}
  <div class="wrap prose-field pb-6">
    <p class="max-w-[58ch]">
      Where I haven't checked something it says so rather than guessing, and
      when I get something wrong the old claim stays on the page.
      <a href="/how-we-verify/">The method, and the three I've already got
      wrong</a>. <a href="/verified/">Every page with its source and age</a>.
    </p>
  </div>
</Layout>
