# Optional. The park finder at /ask/ works without this — it falls back to a
# deterministic summary sentence and the same results. Setting it turns on the
# conversational framing and the suggested follow-ups.
#
# Deploy the worker from ~/deep-creek-chat-worker, then paste its URL here for
# local dev, and set a repo variable of the same name for production
# (Settings → Secrets and variables → Actions → Variables).
PUBLIC_CHAT_ENDPOINT=
